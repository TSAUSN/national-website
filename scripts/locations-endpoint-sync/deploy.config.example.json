{
  "projectId": "PROJECT_ID",
  "region": "us-central1",
  "functionName": "locations-endpoint-sync",
  "runtime": "nodejs20",
  "entryPoint": "locationsWebhook",
  "memory": "256Mi",
  "timeoutSeconds": 60,
  "maxInstances": 1,
  "concurrency": 1,
  "allowUnauthenticated": true,
  "envVars": {
    "INSTANCE_ZUID": "",
    "LOCATIONS_ENDPOINT_PATH": "",
    "LOCATIONS_LIVE_DOMAIN": "",
    "LOCATIONS_PREVIEW_DOMAIN": "",
    "LOCATIONS_VIEW_ZUID": "",
    "LOCATIONS_VIEW_DEV_ZUID": "",
    "REBUILD_DEBOUNCE_MS": "45000",
    "PUBLISH_PROPAGATION_DELAY_MS": "5000",
    "LOCATIONS_FETCH_TIMEOUT_MS": "120000",
    "LOCATIONS_FETCH_MAX_RETRIES": "3",
    "LOCATIONS_FETCH_RETRY_DELAY_MS": "15000",
    "LOG_TO_FILE": "false"
  },
  "secrets": {
    "DEV_TOKEN": "locations-webhook-dev-token:latest"
  }
}
