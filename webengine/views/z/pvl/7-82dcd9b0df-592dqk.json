							"content:wysiwyg_basic:4:79": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#FFFFFF;\">\n                    <h6 style=\"text-align:center;\">Baton Rouge:</h6>\n\n<ul>\n\t<li><strong>Clothes voucher </strong>– emergency basis only (fire, flood, hurricane, tornado, homeless, etc); need proof of emergency and current LA ID/license; by appointment only. Vouchers can only be claimed at the Coursey Family Store in Baton Rouge.</li>\n\t<li><strong>Furniture/appliance Voucher </strong>– unable to do at this time</li>\n\t<li><strong>Energy Assistance </strong>– through Entergy’s Power to Care Program, must be elderly (60 and above) or receive disability, or have a child receiving disability; person applying for assistance must have their name on the bill and live at the address; must present emergency reason for needing assistance, income-based; by appointment only</li>\n</ul>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<div class=\"text-white rounded p-6 gap-3 my-5\" style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/d66aa8be-9105-4e58-b95b-3484d0e03f67_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#FFFFFF;\">\n                    <h6 style=\"text-align:center;\">Baton Rouge:</h6>\n\n<ul>\n\t<li><strong>Clothes voucher </strong>– emergency basis only (fire, flood, hurricane, tornado, homeless, etc); need proof of emergency and current LA ID/license; by appointment only. Vouchers can only be claimed at the Coursey Family Store in Baton Rouge.</li>\n\t<li><strong>Furniture/appliance Voucher </strong>– unable to do at this time</li>\n\t<li><strong>Energy Assistance </strong>– through Entergy’s Power to Care Program, must be elderly (60 and above) or receive disability, or have a child receiving disability; person applying for assistance must have their name on the bill and live at the address; must present emergency reason for needing assistance, income-based; by appointment only</li>\n</ul>\n                </div>\n            </div>\n        </div>",
