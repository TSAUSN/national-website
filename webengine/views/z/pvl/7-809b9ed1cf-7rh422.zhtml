      <!-- Statistical highlights tables -->
      <div class="row g-5 mb-5">
        <div class="col-lg-6">
          <p class="ar-table-title">Service Touchpoints</p>
          <div class="ar-datatable mb-4">
              <div class="ar-datarow"><span class="ar-datalabel">Basic Social Services</span><span class="ar-num">11,669,785</span></div>
              <div class="ar-datarow"><span class="ar-datalabel">Personal Connections (Interviews, Case Management, Information Requests)</span><span class="ar-num">7,312,182</span></div>
              <div class="ar-datarow"><span class="ar-datalabel">Community Center &amp; Kroc Participants</span><span class="ar-num">4,842,224</span></div>
