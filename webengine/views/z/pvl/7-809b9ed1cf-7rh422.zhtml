            <div class="ar-bar-track"><div class="ar-bar-fill ar-fill-red" style="width:22%;"></div></div>
          </div>
          <div class="ar-bar-row">
            <div class="ar-bar-label"><span>Program Service Fees</span><span>$167,075</span></div>
            <div class="ar-bar-track"><div class="ar-bar-fill ar-fill-red" style="width:7%;"></div></div>
