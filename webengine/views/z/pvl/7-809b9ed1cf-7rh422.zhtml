            <div class="ar-bar-track"><div class="ar-bar-fill ar-fill-navy" style="width:100%;"></div></div>
          </div>
          <div class="ar-bar-row">
            <div class="ar-bar-label"><span>Corps Community Center</span><span>$893,521</span></div>
            <div class="ar-bar-track"><div class="ar-bar-fill ar-fill-navy" style="width:66%;"></div></div>
          </div>
