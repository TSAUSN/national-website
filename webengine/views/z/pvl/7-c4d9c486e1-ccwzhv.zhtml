	<div data-zesty-id="content:block:6-bcfbdaa6d3-vjj3qs:27:83:0:82">{{block('/-/block/hero_full.html?variant=7-f0e8feade6-g4f472')}}</div>
	<div class="p-6 rounded-5 bg-light mb-18" data-zesty-id="design:columns:1 column - 1 row my-3:22:33">
