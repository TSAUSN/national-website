								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 bg-light text-dark\"><h5 style=\"text-align:center;\"> </h5>\n\n<h5 style=\"text-align:center;\">Registration Days and Hours</h5>\n\n<p style=\"text-align:center;\">\n\t<strong>Monday thru Thursday</strong> from 4:00pm\n</p>\n\n<p style=\"text-align:center;\">\n\t<strong>No weekend</strong> entries at this time\n</p>\n\n<p style=\"text-align:center;\">\n\tFor more information or for any questions, please call our Social Services Department at <a href=\"tel:504-899-4569\" target=\"\">(504) 899-4569</a>.\n</p>\n\n<p style=\"text-align:center;\">\n\t \n</p></div>",
