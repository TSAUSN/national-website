{"layout:root:column:0":{"name":"layout:root:column:0","html":"<div className={styles.pvlRoot}>*</div>","children":{"content:images:0:90":{"icon":"images","name":"Image","type":"images","description":"Reference to image ZUIDs in Zesty.io","html":"<img width=\"100%\" src=\"https://8hxvw8tw.media.zestyio.com/Coaches-and-Volunteers---RBA.png\" alt=\"placeholder\">","draggable":true,"content":"https://8hxvw8tw.media.zestyio.com/Coaches-and-Volunteers---RBA.png","position":0,"fullName":"content:images:0:90","htmlElement":"img","primarytype":"content","id":"content:images:0:90","styles":{},"newLoc":"layout:root:column:0","contentOverride":false},"content:embed:1:35":{"html":"<style>\n/* ==============================\n   COACHING PAGE\n   ============================== */\n\n.rba-coaching {\n   width: 100%;\n        max-width: 1800px;\n        margin: 40px auto 30px auto;\n    font-family: Arial, Helvetica, sans-serif;\n}\n\n\n/* ==============================\n   PAGE BANNER\n   ============================== */\n\n.coaching-banner {\n    position: relative;\n    height: 300px;\n    border-radius: 20px;\n    overflow: hidden;\n    margin-bottom: 35px;\n\n    background:\n        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),\n        url(\"YOUR-IMAGE-URL-HERE\") center center / cover no-repeat;\n\n    display: flex;\n    align-items: center;\n    padding-left: 60px;\n}\n\n.coaching-banner h1 {\n    color: #ffffff;\n    font-size: 52px;\n    font-weight: 500;\n    margin: 0;\n}\n\n\n/* ==============================\n   COACHING SECTIONS\n   ============================== */\n\n.rba-coach-card {\n    background: #ffffff;\n    border: 1px solid #e5e5e5;\n    border-radius: 16px;\n    padding: 35px 40px;\n    margin-bottom: 25px;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.04);\n}\n\n.rba-coach-card h2 {\n    margin: 0 0 20px 0;\n    font-size: 30px;\n    font-weight: 600;\n    color: #222222;\n}\n\n.rba-coach-card h3 {\n    margin: 28px 0 10px 0;\n    font-size: 19px;\n    font-weight: 600;\n    color: #333333;\n}\n\n.rba-coach-card p {\n    margin: 0 0 15px 0;\n    font-size: 16px;\n    line-height: 1.7;\n    color: #555555;\n}\n\n\n/* ==============================\n   REQUIREMENTS LIST\n   ============================== */\n\n.rba-coach-card ul {\n    margin: 15px 0 20px 0;\n    padding-left: 25px;\n}\n\n.rba-coach-card li {\n    margin-bottom: 12px;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #555555;\n}\n\n\n/* Links */\n\n.rba-coach-card a {\n    color: #333333;\n    font-weight: 600;\n    text-decoration: underline;\n}\n\n.rba-coach-card a:hover {\n    opacity: 0.7;\n}\n\n\n/* ==============================\n   COACH OF THE YEAR IMAGE\n   ============================== */\n\n.coach-of-year-image {\n    text-align: center;\n    margin-top: 25px;\n}\n\n.coach-of-year-image img {\n    width: 75%;\n    max-width: 750px;\n    height: auto;\n    border-radius: 10px;\n    display: inline-block;\n}\n\n\n/* ==============================\n   MOBILE\n   ============================== */\n\n@media (max-width: 768px) {\n\n    .rba-coaching {\n        margin: 25px 15px;\n    }\n\n    .coaching-banner {\n        height: 220px;\n        padding-left: 30px;\n        border-radius: 15px;\n    }\n\n    .coaching-banner h1 {\n        font-size: 36px;\n    }\n\n    .rba-coach-card {\n        padding: 25px;\n        border-radius: 12px;\n    }\n\n    .rba-coach-card h2 {\n        font-size: 25px;\n    }\n\n    .rba-coach-card h3 {\n        font-size: 18px;\n    }\n\n    .rba-coach-card p,\n    .rba-coach-card li {\n        font-size: 15px;\n    }\n\n    .coach-of-year-image img {\n        width: 100%;\n    }\n}\n</style>\n\n\n<div class=\"rba-coaching\">\n\n\n\n    <!-- ==============================\n         COACH REQUIREMENTS\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>Coach Requirements</h2>\n\n        <p>\n            The Rookie Basketball program relies on volunteers to coach teams\n            for each winter season. The time commitment varies from one to\n            three hours per week. <u>If you volunteered for this role last year,\n            you will need to register but you do not need to fill out a new\n            application.</u> \n     </p> \n<p>\nRegistration for volunteer coaches for the 2026–2027\n            season is now open.\n        </p>\n\n        <h3>Each volunteer will need to complete the following:</h3>\n\n        <ul>\n\n            <li>\n                Online volunteer application and registration, including\n                references.\n                <a href=\"https://x.gldn.io/e/Ie8AGhIJP3b\" target=\"_blank\">\n                    Click here to apply.\n                </a>\n            </li>\n\n            <li>\n                Online background check, linked in the volunteer application.\n            </li>\n\n            <li>\n                Attend Salvation Army Safe From Harm training, good for four\n                years.\n            </li>\n\n            <li>\n                Online concussion training, state-mandated and needed every\n                three years.\n                <a href=\"https://nfhslearn.com/courses/concussion-in-sports-2\"\n                   target=\"_blank\">\n                    View training.\n                </a>\n            </li>\n\n            <li>\n                Attend coaches meeting and training, date to be determined.\n            </li>\n\n            <li>\n                To register as a volunteer coach, \n                <a href=\"https://duluthrba.leagueapps.com/leagues/basketball/4665516-20252026-volunteer-coach-registration\"\n                   target=\"_blank\">\n                    click here.\n                </a>\n            </li>\n\n        </ul>\n\n    </section>\n\n\n    <!-- ==============================\n         COACHING RESOURCES\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>Coaching Resources</h2>\n\n        <p>\n          <ul> <li> <a href=\"https://drive.google.com/file/d/1j0fIdzjl4_xBsU0dIUK3kQ0w8OKdIIKM/view?usp=sharing\" target=\"_blank\" rel=\"noopener noreferrer\">RBA Coaches Guide</a> </li> <li> <a href=\"https://s3.amazonaws.com/usc-cache.salvationarmy.org/361d1eb4-5b84-41b8-95c8-dc0f871e2286_RBDuluth-Basketball-Signal-Chart.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">Official basketball Signal Chart</a></li> <li> <a href=\"https://s3.amazonaws.com/usc-cache.salvationarmy.org/7197be99-f39a-436d-be68-5957c13d17a4_Rookie-Basketball-Coaching-Resources.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">RBA Coaching Tips, Tools, and other Resources</a>  </li> </ul>\n        </p>\n\n \n\n    </section>\n\n\n    <!-- ==============================\n         COACH OF THE YEAR\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>2025–2026 Coach of the Year – Beth Moncrief</h2>\n\n        <div class=\"coach-of-year-image\">\n\n            <img\n                src=\"https://8hxvw8tw.media.zestyio.com/WEB-COY-25.26-BMoncrief.webp\"\n                alt=\"2025–2026 Coach of the Year – Beth Moncrief\"\n            >\n\n        </div>\n\n    </section>\n\n\n</div>","content":"<style>\n/* ==============================\n   COACHING PAGE\n   ============================== */\n\n.rba-coaching {\n   width: 100%;\n        max-width: 1800px;\n        margin: 40px auto 30px auto;\n    font-family: Arial, Helvetica, sans-serif;\n}\n\n\n/* ==============================\n   PAGE BANNER\n   ============================== */\n\n.coaching-banner {\n    position: relative;\n    height: 300px;\n    border-radius: 20px;\n    overflow: hidden;\n    margin-bottom: 35px;\n\n    background:\n        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),\n        url(\"YOUR-IMAGE-URL-HERE\") center center / cover no-repeat;\n\n    display: flex;\n    align-items: center;\n    padding-left: 60px;\n}\n\n.coaching-banner h1 {\n    color: #ffffff;\n    font-size: 52px;\n    font-weight: 500;\n    margin: 0;\n}\n\n\n/* ==============================\n   COACHING SECTIONS\n   ============================== */\n\n.rba-coach-card {\n    background: #ffffff;\n    border: 1px solid #e5e5e5;\n    border-radius: 16px;\n    padding: 35px 40px;\n    margin-bottom: 25px;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.04);\n}\n\n.rba-coach-card h2 {\n    margin: 0 0 20px 0;\n    font-size: 30px;\n    font-weight: 600;\n    color: #222222;\n}\n\n.rba-coach-card h3 {\n    margin: 28px 0 10px 0;\n    font-size: 19px;\n    font-weight: 600;\n    color: #333333;\n}\n\n.rba-coach-card p {\n    margin: 0 0 15px 0;\n    font-size: 16px;\n    line-height: 1.7;\n    color: #555555;\n}\n\n\n/* ==============================\n   REQUIREMENTS LIST\n   ============================== */\n\n.rba-coach-card ul {\n    margin: 15px 0 20px 0;\n    padding-left: 25px;\n}\n\n.rba-coach-card li {\n    margin-bottom: 12px;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #555555;\n}\n\n\n/* Links */\n\n.rba-coach-card a {\n    color: #333333;\n    font-weight: 600;\n    text-decoration: underline;\n}\n\n.rba-coach-card a:hover {\n    opacity: 0.7;\n}\n\n\n/* ==============================\n   COACH OF THE YEAR IMAGE\n   ============================== */\n\n.coach-of-year-image {\n    text-align: center;\n    margin-top: 25px;\n}\n\n.coach-of-year-image img {\n    width: 75%;\n    max-width: 750px;\n    height: auto;\n    border-radius: 10px;\n    display: inline-block;\n}\n\n\n/* ==============================\n   MOBILE\n   ============================== */\n\n@media (max-width: 768px) {\n\n    .rba-coaching {\n        margin: 25px 15px;\n    }\n\n    .coaching-banner {\n        height: 220px;\n        padding-left: 30px;\n        border-radius: 15px;\n    }\n\n    .coaching-banner h1 {\n        font-size: 36px;\n    }\n\n    .rba-coach-card {\n        padding: 25px;\n        border-radius: 12px;\n    }\n\n    .rba-coach-card h2 {\n        font-size: 25px;\n    }\n\n    .rba-coach-card h3 {\n        font-size: 18px;\n    }\n\n    .rba-coach-card p,\n    .rba-coach-card li {\n        font-size: 15px;\n    }\n\n    .coach-of-year-image img {\n        width: 100%;\n    }\n}\n</style>\n\n\n<div class=\"rba-coaching\">\n\n\n\n    <!-- ==============================\n         COACH REQUIREMENTS\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>Coach Requirements</h2>\n\n        <p>\n            The Rookie Basketball program relies on volunteers to coach teams\n            for each winter season. The time commitment varies from one to\n            three hours per week. <u>If you volunteered for this role last year,\n            you will need to register but you do not need to fill out a new\n            application.</u> \n     </p> \n<p>\nRegistration for volunteer coaches for the 2026–2027\n            season is now open.\n        </p>\n\n        <h3>Each volunteer will need to complete the following:</h3>\n\n        <ul>\n\n            <li>\n                Online volunteer application and registration, including\n                references.\n                <a href=\"https://x.gldn.io/e/Ie8AGhIJP3b\" target=\"_blank\">\n                    Click here to apply.\n                </a>\n            </li>\n\n            <li>\n                Online background check, linked in the volunteer application.\n            </li>\n\n            <li>\n                Attend Salvation Army Safe From Harm training, good for four\n                years.\n            </li>\n\n            <li>\n                Online concussion training, state-mandated and needed every\n                three years.\n                <a href=\"https://nfhslearn.com/courses/concussion-in-sports-2\"\n                   target=\"_blank\">\n                    View training.\n                </a>\n            </li>\n\n            <li>\n                Attend coaches meeting and training, date to be determined.\n            </li>\n\n            <li>\n                To register as a volunteer coach, \n                <a href=\"https://duluthrba.leagueapps.com/leagues/basketball/4665516-20252026-volunteer-coach-registration\"\n                   target=\"_blank\">\n                    click here.\n                </a>\n            </li>\n\n        </ul>\n\n    </section>\n\n\n    <!-- ==============================\n         COACHING RESOURCES\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>Coaching Resources</h2>\n\n        <p>\n          <ul> <li> <a href=\"https://drive.google.com/file/d/1j0fIdzjl4_xBsU0dIUK3kQ0w8OKdIIKM/view?usp=sharing\" target=\"_blank\" rel=\"noopener noreferrer\">RBA Coaches Guide</a> </li> <li> <a href=\"https://s3.amazonaws.com/usc-cache.salvationarmy.org/361d1eb4-5b84-41b8-95c8-dc0f871e2286_RBDuluth-Basketball-Signal-Chart.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">Official basketball Signal Chart</a></li> <li> <a href=\"https://s3.amazonaws.com/usc-cache.salvationarmy.org/7197be99-f39a-436d-be68-5957c13d17a4_Rookie-Basketball-Coaching-Resources.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">RBA Coaching Tips, Tools, and other Resources</a>  </li> </ul>\n        </p>\n\n \n\n    </section>\n\n\n    <!-- ==============================\n         COACH OF THE YEAR\n         ============================== -->\n\n    <section class=\"rba-coach-card\">\n\n        <h2>2025–2026 Coach of the Year – Beth Moncrief</h2>\n\n        <div class=\"coach-of-year-image\">\n\n            <img\n                src=\"https://8hxvw8tw.media.zestyio.com/WEB-COY-25.26-BMoncrief.webp\"\n                alt=\"2025–2026 Coach of the Year – Beth Moncrief\"\n            >\n\n        </div>\n\n    </section>\n\n\n</div>","name":"Embed","position":1,"fullName":"content:embed:1:35","htmlElement":"iframe","type":"embed","primarytype":"content","id":"content:embed:1:35","styles":{},"newLoc":"layout:root:column:0","contentOverride":false}}}}