					<li>3 Meals a day</li>
					<li>Clothing</li>
					<li>Showers</li>
					<li>Laundry facilities</li>
					<li>Counseling</li>
					<li>Work therapy</li>
					<li>Support groups</li>
				</ul>
			</div>
