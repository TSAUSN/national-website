							"content:textarea:8:44": {
								"icon": "align-justify",
								"name": "Paragraph",
								"type": "textarea",
								"html": "<p>\n\tA generous program grant from Bon Secours Richmond Health System enables membership to the Oasis Wellness Center to be accessible and affordable.\n</p>",
								"description": "Mixed Plain and Rich Text",
								"draggable": true,
								"content": "A generous program grant from Bon Secours Richmond Health System enables membership to the Oasis Wellness Center to be accessible and affordable.",
