							"content:wysiwyg_basic:17:52": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 mt-3 bg-light text-dark\"><p>\n\t&nbsp;\n</p>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p>\n\t\t\t\t\t<img src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/fa4e4917-37ba-4e18-be87-fa345000e4fe_Camp%2Bphoto%2B2.jpeg\" style=\"display:block;margin-left:auto;margin-right:auto;\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h5><span style=\"font-size:20px;\">Summer Camp&nbsp;</span></h5>\n\n\t\t\t\t<p>\n\t\t\t\t\tMany children leave school each spring and head out for a fun-filled summer of camps. However, for many kids from income-limited homes, the possibility of going to summer camp is not an option.&nbsp;\n\t\t\t\t</p>\n\n\t\t\t\t<p>\n\t\t\t\t\tWe believe every child should experience summer camp—exploring nature, learning new skills, developing confidence, and building life-long friendships in a fun and nurturing environment. That’s why we offer kids from across Alabama, Louisiana, and Mississippi to experience one or more summer camp programs at Camp Hidden Lake, our 300-acre camp in Lexington, Mississippi.\n\t\t\t\t</p>\n\n\t\t\t\t<p>\n\t\t\t\t\tCamp Hidden Lake is residential for a week (6 days), and transportation is provided. During the week, campers experience long, hot summer days, dips in the pool, star-filled nights, campfires, roasted marshmallows, pillow fights, cabin devotions, emblem work, seeing old friends, and making new ones.\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;\">\n\t\t\t\t\tFor more information, &nbsp;call <a href=\"tel:+12253554483\" target=\"\">225-355-4483</a> x.401\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div></div>",
								"content": "<div class=\"rounded p-6 gap-3 mt-3 bg-light text-dark\" style=\"color:#111111;\"><p>\n\t&nbsp;\n</p>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p>\n\t\t\t\t\t<img src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/fa4e4917-37ba-4e18-be87-fa345000e4fe_Camp%2Bphoto%2B2.jpeg\" style=\"display:block;margin-left:auto;margin-right:auto;\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-8\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<h5><span style=\"font-size:20px;\">Summer Camp&nbsp;</span></h5>\n\n\t\t\t\t<p>\n\t\t\t\t\tMany children leave school each spring and head out for a fun-filled summer of camps. However, for many kids from income-limited homes, the possibility of going to summer camp is not an option.&nbsp;\n\t\t\t\t</p>\n\n\t\t\t\t<p>\n\t\t\t\t\tWe believe every child should experience summer camp—exploring nature, learning new skills, developing confidence, and building life-long friendships in a fun and nurturing environment. That’s why we offer kids from across Alabama, Louisiana, and Mississippi to experience one or more summer camp programs at Camp Hidden Lake, our 300-acre camp in Lexington, Mississippi.\n\t\t\t\t</p>\n\n\t\t\t\t<p>\n\t\t\t\t\tCamp Hidden Lake is residential for a week (6 days), and transportation is provided. During the week, campers experience long, hot summer days, dips in the pool, star-filled nights, campfires, roasted marshmallows, pillow fights, cabin devotions, emblem work, seeing old friends, and making new ones.\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;\">\n\t\t\t\t\tFor more information, &nbsp;call <a href=\"tel:+12253554483\" target=\"\">225-355-4483</a> x.401\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div></div>",
