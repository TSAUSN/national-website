											"content:textarea:12:54": {
												"icon": "align-justify",
												"name": "Paragraph",
												"type": "textarea",
												"html": "<p>\n\t\t\t\t\t&nbsp;The Sunbeam program is for girls in grades 1-5. the Girl Guards is for girls in grades 6-12. the purpose of both of these guarding programs is to give girls an opportunity for personal growth spiritually, mentally, physically, and socially, thereby increasing their understanding of life and service. It emphasizes discipleship, evangelism, and the development of life skills. It also offers opportunities for building relationships with other youths in the community.&nbsp;\n\t\t\t\t</p>",
												"description": "Mixed Plain and Rich Text",
