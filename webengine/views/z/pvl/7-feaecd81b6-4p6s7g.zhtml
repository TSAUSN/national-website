	<style>
    .rba-card {
        width: 100%;
        max-width: 1800px;
        margin: 40px auto 30px auto;
        padding: 35px 45px;
        box-sizing: border-box;
        background-color: #ffffff;
        border-radius: 12px;
    }

    .rba-card h2 {
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 30px;
    }

    .rba-card h3 {
        margin-top: 30px;
        margin-bottom: 10px;
        font-size: 22px;
    }

    .rba-card p {
        font-size: 17px;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .rba-card ul {
        font-size: 17px;
