<div className={styles.pvlRoot}>
	<div class="row my-3 p-6 rounded-5 bg-light mb-18">
		<div class="col-lg-12 col-md-12 col-sm-12">
			<div class="pvlRichtext board-chair-quote text-white rounded my-4" style="position:relative;overflow:hidden;min-height:320px;background-image:url("><section style="position:relative;overflow:hidden;min-height:320px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/20734da0-fda0-48ee-9d3c-e605fd699c33_Untitled+design+%287%29.png');background-position:center center;background-repeat:no-repeat;background-size:cover;" class="board-chair-quote text-white rounded my-4">
            <div class="bg-photo-overlay bg-opacity-60" style="position:absolute;inset:0;z-index:1;"></div>
            <div style="position:absolute;inset:0;z-index:2;display:flex;align-items:center;justify-content:center;padding:32px 40px;">
                <div style="max-width:760px;width:100%;text-align:center;">
                    <blockquote style="margin:0;padding:0;text-align:center;"><p style="margin:0;padding:0;text-align:center;color:#fff;">The Salvation Army does not just offer a handout but a hand-up to discourage comfortability in poverty. This organization is committed to making an effective, and lasting impact on those in need.</p><footer style="margin-top:16px;"><strong>Peter Darbee</strong></footer></blockquote>
                </div>
            </div>
        </section>
        <div class="py-5"></div></div>
			<div class="my-2"></div>
			<h5 style="text-align:center;">Our Advisory Board Members</h5>
			<p style="text-align:center;max-width:768px;margin:auto;" class="u-textLg u-textGreyMedium no-margin-bottom padding-left-md padding-right-md">The Northeast Florida Advisory Board consists of a wide variety of hard-working men and women who share the vision to transform and restore lives in the city of Jacksonville.</p>
			<hr>
			<h5 style="text-align:center;">Officers / Executive Committee</h5>
