<section style="position:relative;overflow:hidden;min-height:320px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/20734da0-fda0-48ee-9d3c-e605fd699c33_Untitled+design+%287%29.png');background-position:center center;background-repeat:no-repeat;background-size:cover;" class="board-chair-quote text-white rounded my-4" data-zesty-id="content:wysiwyg_basic:1:73">
