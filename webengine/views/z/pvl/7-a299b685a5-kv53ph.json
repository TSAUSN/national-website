							"content:wysiwyg_basic:2:5": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 bg-light text-dark\"><h6 style=\"text-align:center;\"> </h6>\n\n<h6 style=\"text-align:center;\">New Orleans<br>\n<strong>Christmas Impact Report</strong><br>\n2021</h6>\n\n<h5 style=\"text-align:center;\">We spread Christmas Cheer!</h5>\n\n<p style=\"text-align:center;\">\n\t<span style=\"font-family:&quot;Book Antiqua&quot;,serif;\">The iconic sound of a ringing bell, along with the site of a red kettle, is a sure sign that the Christmas Season is upon The Salvation Army. We spread Christmas joy throughout the season, but we could not do it without community support. Whether it’s volunteering to ring the bell, adopt an angel, either a child or a senior citizen from our Angel Tree, or helping collect, sort, package, and distribute toys and clothing to those angels adopted, The Salvation Army offers many ways you can help bring a little Christmas Cheer to those who would otherwise go without. Last year alone, The Salvation Army of Greater New Orleans provided gifts to more than 1,300 individuals, including:</span>\n</p></div>",
								"content": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 bg-light text-dark\"><h6 style=\"text-align:center;\"> </h6>\n\n<h6 style=\"text-align:center;\">New Orleans<br>\n<strong>Christmas Impact Report</strong><br>\n2021</h6>\n\n<h5 style=\"text-align:center;\">We spread Christmas Cheer!</h5>\n\n<p style=\"text-align:center;\">\n\t<span style=\"font-family:&quot;Book Antiqua&quot;,serif;\">The iconic sound of a ringing bell, along with the site of a red kettle, is a sure sign that the Christmas Season is upon The Salvation Army. We spread Christmas joy throughout the season, but we could not do it without community support. Whether it’s volunteering to ring the bell, adopt an angel, either a child or a senior citizen from our Angel Tree, or helping collect, sort, package, and distribute toys and clothing to those angels adopted, The Salvation Army offers many ways you can help bring a little Christmas Cheer to those who would otherwise go without. Last year alone, The Salvation Army of Greater New Orleans provided gifts to more than 1,300 individuals, including:</span>\n</p></div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"model": "6",
