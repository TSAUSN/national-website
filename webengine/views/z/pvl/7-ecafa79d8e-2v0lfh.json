							"content:wysiwyg_basic:4:3": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/e94f0f47-ae74-4090-8a13-6b07cc2c4105_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#FFFFFF;\">\n                    <h5 style=\"text-align:center;\">Who Can Join?</h5>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<img src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/60f441d1-9e93-4274-ad05-13965a2e7777_path-way.jpeg\" style=\"display:block;margin-left:auto;margin-right:auto;\" class=\"d-block mx-auto img-fluid rounded\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>You’re Eligible if:</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>You have at least one child under the age of 18.</li>\n\t\t\t\t\t<li>You’re Ready to take action!</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>What will it involve?</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tCaring today for your family’s needs while building a strong future can be challenging. The Salvation Army Team will walk along side you on your family’s journey:\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>Mapping it out— Meet with a caseworker to develop a personalized action plan.</li>\n\t\t\t\t\t<li>Staying on track— Chart your progress and see your success with your dedicated caseworker on a regular basis.</li>\n\t\t\t\t\t<li>Passing the six month mile marker— See where you are at six months and decide what’s next on your journey.</li>\n\t\t\t\t\t<li>Looking ahead— Celebrate your successes. Adjust any further goals. Encourage others.</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
								"description": "Text with HTML references.",
								"draggable": true,
								"content": "<div style=\"position:relative;overflow:hidden;min-height:300px;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/e94f0f47-ae74-4090-8a13-6b07cc2c4105_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#FFFFFF;\">\n                    <h5 style=\"text-align:center;\">Who Can Join?</h5>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<img src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/60f441d1-9e93-4274-ad05-13965a2e7777_path-way.jpeg\" style=\"display:block;margin-left:auto;margin-right:auto;\" class=\"d-block mx-auto img-fluid rounded\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>You’re Eligible if:</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>You have at least one child under the age of 18.</li>\n\t\t\t\t\t<li>You’re Ready to take action!</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>What will it involve?</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tCaring today for your family’s needs while building a strong future can be challenging. The Salvation Army Team will walk along side you on your family’s journey:\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>Mapping it out— Meet with a caseworker to develop a personalized action plan.</li>\n\t\t\t\t\t<li>Staying on track— Chart your progress and see your success with your dedicated caseworker on a regular basis.</li>\n\t\t\t\t\t<li>Passing the six month mile marker— See where you are at six months and decide what’s next on your journey.</li>\n\t\t\t\t\t<li>Looking ahead— Celebrate your successes. Adjust any further goals. Encourage others.</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
								"model": "6",
								"manualContent": "<div style=\"position:relative;overflow:hidden;min-height:300px;background:#000000 url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/e94f0f47-ae74-4090-8a13-6b07cc2c4105_Blue+BG.png') center center / cover no-repeat;background-image:url('https://s3.amazonaws.com/uss-cache.salvationarmy.org/e94f0f47-ae74-4090-8a13-6b07cc2c4105_Blue+BG.png');background-position:center center;background-repeat:no-repeat;background-size:cover;\" class=\"text-white rounded p-6 gap-3 my-5\">\n            <div style=\"position:absolute;inset:0;z-index:2;\"></div>\n            <div style=\"position:relative;z-index:3;display:flex;align-items:center;justify-content:flex-start;min-height:300px;\">\n                <div style=\"width:100%;padding:40px;color:#FFFFFF;\">\n                    <h5 style=\"text-align:center;\">Who Can Join?</h5>\n\n<div class=\"btgrid\">\n\t<div class=\"row row-1\">\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<img src=\"https://s3.amazonaws.com/uss-cache.salvationarmy.org/60f441d1-9e93-4274-ad05-13965a2e7777_path-way.jpeg\" style=\"display:block;margin-left:auto;margin-right:auto;\" class=\"d-block mx-auto img-fluid rounded\">\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>You’re Eligible if:</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>You have at least one child under the age of 18.</li>\n\t\t\t\t\t<li>You’re Ready to take action!</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"col col-md-4 col-lg-4 col-sm-12 col-xs-12\">\n\t\t\t<div class=\"content\">\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\t<strong>What will it involve?</strong>\n\t\t\t\t</p>\n\n\t\t\t\t<p style=\"text-align:center;color:#fff;\">\n\t\t\t\t\tCaring today for your family’s needs while building a strong future can be challenging. The Salvation Army Team will walk along side you on your family’s journey:\n\t\t\t\t</p>\n\n\t\t\t\t<ul>\n\t\t\t\t\t<li>Mapping it out— Meet with a caseworker to develop a personalized action plan.</li>\n\t\t\t\t\t<li>Staying on track— Chart your progress and see your success with your dedicated caseworker on a regular basis.</li>\n\t\t\t\t\t<li>Passing the six month mile marker— See where you are at six months and decide what’s next on your journey.</li>\n\t\t\t\t\t<li>Looking ahead— Celebrate your successes. Adjust any further goals. Encourage others.</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n                </div>\n            </div>\n        </div>",
