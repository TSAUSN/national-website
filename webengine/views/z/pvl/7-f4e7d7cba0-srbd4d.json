							"content:wysiwyg_basic:2:18": {
								"icon": "outdent",
								"name": "WYSIWYG",
								"type": "wysiwyg_basic",
								"html": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 bg-light text-dark\"><h5 style=\"text-align:center;\">The Salvation Army Is a Church!</h5>\n\n<p style=\"text-align:center;\">\n\t<span style=\"font-size:20px;\"><br>\n\t<br>\n\tYou might know us as the people who help with food, clothes, rent/utility assistance, or in times of disaster. However, did you know worship is at the core of The Salvation Army? We offer weekly Bible studies, youth programs, men’s/women’s ministries, and Sunday worship. We invite you to experience and explore God in a loving and caring family environment.<br>\n\t<br>\n\tWe offer services in two languages: English and Spanish. <br>\n\t<br>\n\tEvery Sunday:<br>\n\t9:15Am - <a href=\"http://salvationarmygwinnett.org/espantildeol.html\">Spanish</a><br>\n\t10:30Am - <a href=\"http://salvationarmygwinnett.org/english.html\">English</a></span>\n</p>\n\n<hr>\n<h5 style=\"text-align:center;\"><span style=\"font-size:18px;\">Click the service below for mor</span><span style=\"font-size:18px;\">e information.</span></h5>\n\n<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"https://southernusa.salvationarmy.org/gwinnett/english-worship\" class=\"btn btn-secondary gap-1 mt-2\">English</a></p>\n\n<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"https://southernusa.salvationarmy.org/gwinnett/espaol\" class=\"btn btn-secondary gap-1 mt-2\">Spanish</a></p>\n\n<p style=\"text-align:center;\">\n\t \n</p>\n\n<p>\n\t \n</p></div>",
								"content": "<div style=\"color:#111111;\" class=\"rounded p-6 gap-3 bg-light text-dark\"><h5 style=\"text-align:center;\">The Salvation Army Is a Church!</h5>\n\n<p style=\"text-align:center;\">\n\t<span style=\"font-size:20px;\"><br>\n\t<br>\n\tYou might know us as the people who help with food, clothes, rent/utility assistance, or in times of disaster. However, did you know worship is at the core of The Salvation Army? We offer weekly Bible studies, youth programs, men’s/women’s ministries, and Sunday worship. We invite you to experience and explore God in a loving and caring family environment.<br>\n\t<br>\n\tWe offer services in two languages: English and Spanish. <br>\n\t<br>\n\tEvery Sunday:<br>\n\t9:15Am - <a href=\"http://salvationarmygwinnett.org/espantildeol.html\">Spanish</a><br>\n\t10:30Am - <a href=\"http://salvationarmygwinnett.org/english.html\">English</a></span>\n</p>\n\n<hr>\n<h5 style=\"text-align:center;\"><span style=\"font-size:18px;\">Click the service below for mor</span><span style=\"font-size:18px;\">e information.</span></h5>\n\n<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"https://southernusa.salvationarmy.org/gwinnett/english-worship\" class=\"btn btn-secondary gap-1 mt-2\">English</a></p>\n\n<p style=\"text-align:center;\" class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\"><a href=\"https://southernusa.salvationarmy.org/gwinnett/espaol\" class=\"btn btn-secondary gap-1 mt-2\">Spanish</a></p>\n\n<p style=\"text-align:center;\">\n\t \n</p>\n\n<p>\n\t \n</p></div>",
