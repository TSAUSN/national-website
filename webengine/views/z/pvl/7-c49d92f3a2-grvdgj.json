{"layout:root:column:0":{"name":"layout:root:column:0","html":"<div className={styles.pvlRoot}>*</div>","children":{"content:block:6-bcfbdaa6d3-vjj3qs:27:4:0:47":{"model":"6-bcfbdaa6d3-vjj3qs","name":"27","type":"block","html":"{{block('/-/block/hero_full.html?variant=7-a0a69bebf9-svxmr4&version=5')}}","description":"","draggable":true,"content":"{{block('/-/block/hero_full.html?variant=7-a0a69bebf9-svxmr4&version=5')}}","position":0,"fullName":"content:block:6-bcfbdaa6d3-vjj3qs:27:4:0:47","primarytype":"content","newLoc":"layout:root:column:0","oldLoc":"layout:root:column:0","classes":"featured-article bg-opacity-25 mb-4 position-relative rounded-5 position-relative overflow-hidden mb-15","id":"content:block:6-bcfbdaa6d3-vjj3qs:27:4:0:47","blockFieldsReadOnly":false},"design:columns:1 column - 1 row my-3:9:0":{"uid":"301","name":"1 column - 1 row","type":"columns","classes":"row my-3 p-6 rounded-5 bg-light mb-18","html":"<div class=\"row my-3 p-6 rounded-5 bg-light mb-18\">*</div>","preview":"<div style=\"display:flex;flex-direction:row my-3;min-height:20px;\"><div style=\"flex:1\" className={styles.pvlColumn}></div></div>","droppable":false,"numberOfColumns":1,"widthPerColumns":"1","groupCategory":"isNew","group":"","columns":[{"width":"1","html":"<div class=\"col-lg-12 col-md-12 col-sm-12\">*</div>","classes":"col-lg-12 col-md-12 col-sm-12","droppable":true}],"position":1,"fullName":"design:columns:1 column - 1 row my-3:9:0","primarytype":"design","newLoc":"layout:root:column:0","oldLoc":"layout:root:column:0","children":{"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0":{"width":"1","html":"<div class=\"col-lg-12 col-md-12 col-sm-12\">*</div>","classes":"col-lg-12 col-md-12 col-sm-12","droppable":true,"children":{"design:design:whitespace-xl:1:55":{"uid":"354","name":"Whitespace - Extra Large","type":"design","html":"<div class=\"py-5\"></div>","preview":"<div style=\"border-style:dashed; height:50px; width:100%;\"></div>","classes":"py-5","droppable":false,"position":0,"fullName":"design:design:whitespace-xl:1:55","primarytype":"design","newLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0","oldLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0"},"content:wysiwyg_basic:2:66":{"icon":"outdent","name":"WYSIWYG","type":"wysiwyg_basic","html":"<div class=\"pvlRichtext rounded p-6 gap-3 bg-light text-dark\" style=\"color:#111111\"><div class=\"rounded p-6 gap-3 bg-light text-dark\" style=\"color: #111111;\">\n<p style=\"text-align: center;\">Annually, the Red Shield Pro-Am invites our community to the prestigious Elizabeth Manor Golf &amp; Country Club for an impactful and inspiring celebration of the incredible work that happens at The Salvation Army’s hope Village. This year, our golf tournament is set to raise $180,000 to directly support the women and children of hope Village. Hope Village is a life-changing transitional housing program for homeless women and women with children in Hampton Roads. Our goal is to help each woman who enters our program develop the skills needed to thrive on her own and live a fulfilling, successful life.</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-primary gap-1 mt-2\" href=\"https://give.salvationarmymarylandvirginiawestvirginiawashingtondc.org/event/2026-red-shield-golf-pro-am-hrac/e803112\" target=\"_blank\" rel=\"noopener\">Sponsor Today</a></p>\n<p style=\"text-align: center;\">As part of this event, we are seeking silent auction donations of products, services, or experiences that will help make this fundraiser a success.</p>\n<p style=\"text-align: center;\">Your generous contribution will not only support life-transforming programs—it will also spotlight your business to a wide audience. All in-kind sponsors will receive:</p>\n<p style=\"text-align: center;\">Logo placement on signage at the event</p>\n<p style=\"text-align: center;\">Recognition on the online auction platform</p>\n<p style=\"text-align: center;\">Inclusion in a post-event thank-you email to attendees</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-secondary gap-1 mt-2\" href=\"https://forms.cloud.microsoft/r/qB6jPsfB0J\" target=\"_blank\" rel=\"noopener\">Silent Auction Donation Form</a><span style=\"font-size: 20px;\"></span></p>\n</div></div>","description":"Text with HTML references.","draggable":true,"content":"<div class=\"rounded p-6 gap-3 bg-light text-dark\" style=\"color: #111111;\">\n<p style=\"text-align: center;\">Annually, the Red Shield Pro-Am invites our community to the prestigious Elizabeth Manor Golf &amp; Country Club for an impactful and inspiring celebration of the incredible work that happens at The Salvation Army’s hope Village. This year, our golf tournament is set to raise $180,000 to directly support the women and children of hope Village. Hope Village is a life-changing transitional housing program for homeless women and women with children in Hampton Roads. Our goal is to help each woman who enters our program develop the skills needed to thrive on her own and live a fulfilling, successful life.</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-primary gap-1 mt-2\" href=\"https://give.salvationarmymarylandvirginiawestvirginiawashingtondc.org/event/2026-red-shield-golf-pro-am-hrac/e803112\" target=\"_blank\" rel=\"noopener\">Sponsor Today</a></p>\n<p style=\"text-align: center;\">As part of this event, we are seeking silent auction donations of products, services, or experiences that will help make this fundraiser a success.</p>\n<p style=\"text-align: center;\">Your generous contribution will not only support life-transforming programs—it will also spotlight your business to a wide audience. All in-kind sponsors will receive:</p>\n<p style=\"text-align: center;\">Logo placement on signage at the event</p>\n<p style=\"text-align: center;\">Recognition on the online auction platform</p>\n<p style=\"text-align: center;\">Inclusion in a post-event thank-you email to attendees</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-secondary gap-1 mt-2\" href=\"https://forms.cloud.microsoft/r/qB6jPsfB0J\" target=\"_blank\" rel=\"noopener\">Silent Auction Donation Form</a><span style=\"font-size: 20px;\"></span></p>\n</div>","position":1,"fullName":"content:wysiwyg_basic:2:66","htmlElement":"html","styles":{"color":"#111111"},"primarytype":"content","newLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0","oldLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0","classes":"rounded p-6 gap-3 bg-light text-dark","id":"content:wysiwyg_basic:2:66","contentOverride":false,"manualContent":"<div class=\"rounded p-6 gap-3 bg-light text-dark\" style=\"color: #111111;\">\n<p style=\"text-align: center;\">Annually, the Red Shield Pro-Am invites our community to the prestigious Elizabeth Manor Golf &amp; Country Club for an impactful and inspiring celebration of the incredible work that happens at The Salvation Army’s hope Village. This year, our golf tournament is set to raise $180,000 to directly support the women and children of hope Village. Hope Village is a life-changing transitional housing program for homeless women and women with children in Hampton Roads. Our goal is to help each woman who enters our program develop the skills needed to thrive on her own and live a fulfilling, successful life.</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-primary gap-1 mt-2\" href=\"https://give.salvationarmymarylandvirginiawestvirginiawashingtondc.org/event/2026-red-shield-golf-pro-am-hrac/e803112\" target=\"_blank\" rel=\"noopener\">Sponsor Today</a></p>\n<p style=\"text-align: center;\">As part of this event, we are seeking silent auction donations of products, services, or experiences that will help make this fundraiser a success.</p>\n<p style=\"text-align: center;\">Your generous contribution will not only support life-transforming programs—it will also spotlight your business to a wide audience. All in-kind sponsors will receive:</p>\n<p style=\"text-align: center;\">Logo placement on signage at the event</p>\n<p style=\"text-align: center;\">Recognition on the online auction platform</p>\n<p style=\"text-align: center;\">Inclusion in a post-event thank-you email to attendees</p>\n<p class=\"cta-button-group d-flex flex-wrap gap-2 my-3 justify-content-center\" style=\"text-align: center;\"><a class=\"btn btn-secondary gap-1 mt-2\" href=\"https://forms.cloud.microsoft/r/qB6jPsfB0J\" target=\"_blank\" rel=\"noopener\">Silent Auction Donation Form</a><span style=\"font-size: 20px;\"></span></p>\n</div>"},"content:text:1791846679165:0.33391994118288537":{"icon":"text-height","name":"Heading","type":"text","html":"<h3 style=\"text-align:center\">Thank You To Our 2026 Sponsors</h3>","description":"","draggable":true,"content":"Thank You To Our 2026 Sponsors","position":2,"fullName":"content:text:1791846679165:0.33391994118288537","htmlElement":"h3","styles":{"textAlign":"center"},"primarytype":"content","newLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0","oldLoc":"design:columns:1 column - 1 row my-3:9:0-1:1 column - 1 row:0","id":"content:text:1791846679165:0.33391994118288537","manualContent":"Thank You To Our 2026 Sponsors"},"design:design:whitespace-xl:3:47":{"uid":"354","name":"Whitespace - Extra Large","type":"design","html":"<div class=\"py-5\"></div>","preview":"<div style=\"border-style:dashed; height:50px; width:100%;\"></div>","classes":"py-5","droppable":false,"position":3,"fullName":"design:design:whitespace-xl:3:47","primarytype":"design","newLoc":"design:colum