<div className={styles.pvlRoot}>
	<div class="pvlRichtext"><p></p>
<div class="wayout" style="display: flex; flex-direction: column; font-family: 'Inter', Helvetica, Arial, sans-serif; gap: 2.25rem;"><!-- PROMISE -->
<section id="top" class="text-white" style="background-color: #002056; border-radius: 20px; overflow: hidden;">
<div class="row g-4 align-items-stretch" style="margin: 0; padding: clamp(1.5rem,4vw,2.75rem);">
<div class="col-lg-7 d-flex flex-column justify-content-start" style="gap: 1.25rem; margin-top: 0;">
<div style="display: flex; flex-direction: column; gap: 1.25rem; margin: 0; max-width: 100%; padding: 0; width: fit-content;"><img style="display: block; height: auto; margin: 0; max-width: none; min-width: 62%; width: 0;" src="https://8hxvw8tw.media.zestyio.com/theWayOut-White.BJr01H0Dfx.png" alt="The Way Out — Live. Work. Love.">
<h1 style="color: #fff; font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: min(60px, 10.5cqi); font-weight: 600; line-height: 1.05; margin: 0; padding: 0;">Off the streets.<br>Off drugs.<br>Back to life.</h1>
<span style="display: block; font-size: min(48px, 7cqi); font-weight: 600; height: 0; margin-top: -1.25rem; overflow: hidden;" aria-hidden="true">Off the streets. Off drugs.</span></div>
<p class="mb-0" style="font-size: 1.05rem; line-height: 1.55; max-width: 56ch;"><em>The Way Out</em> is a recovery-focused homelessness initiative of The Salvation Army San Francisco designed to get people off the streets, get people off drugs, and give them back their lives.</p>
<p class="mb-0" style="font-size: 1.05rem; line-height: 1.55; max-width: 56ch;">Services are delivered through a Recovery System of Care and include detox, shelter, and stabilization; residential drug treatment; recovery housing and independent living; workforce development and life skills; and an alumni support network.</p>
<div class="d-flex flex-wrap align-items-center" style="gap: min(.75rem, 2cqi); margin-top: .35rem;"><a class="btn btn-primary" style="font-size: max(min(15px, 2.8cqi), 13px); font-weight: 600; padding: .95em .8em;" href="https://give-gs.salvationarmy.org/give/336361?wayout=true&amp;_ga=2.135698103.729685781.1706639656-212087624.1705156517#!/donation/checkout" target="_blank" rel="noopener">Support The Way Out</a> <a class="btn btn-light" style="background-color: #fff; border-color: #fff; color: #002056; font-size: max(min(15px, 2.8cqi), 13px); font-weight: 600; padding: .95em .8em;" href="https://thewayoutsf.wixsite.com/referrals/hl-referral" target="_blank" rel="noopener">Submit a referral</a> <!-- TODO: add the impact report URL --><a class="btn btn-outline-light" style="font-size: max(min(15px, 2.8cqi), 13px); font-weight: 600; padding: .95em .8em;" href="#" target="_blank" rel="noopener">View Impact Report</a></div>
</div>
<div class="col-lg-5 d-flex" style="margin-top: 0;"><!-- keep your current hero photo URL in the src below -->
<div style="border-radius: 12px; flex: 1 1 auto; min-height: 260px; overflow: hidden; position: relative; width: 100%;"><img style="height: 100%; left: 0; margin: 0; object-fit: cover; object-position: center 45%; position: absolute; top: 0; width: 100%;" src="https://8hxvw8tw.media.zestyio.com/REPLACE-the-way-out-hero.jpg" alt="Participants gathered around a barbecue on the beach at sunset"></div>
</div>
</div>
</section>
<!-- RESULTS -->
<section id="results" style="background-color: #eef1f5; border-radius: 20px; padding: clamp(1.25rem,3vw,2rem);">
<h2 class="text-center mb-2" style="color: #002056; font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: clamp(1.5rem,2.6vw,2rem); font-weight: 600;">FY 25/26 OUTCOMES</h2>
<div style="background-color: #ef3e42; height: 3px; margin: 0 auto 1.75rem; width: 58px;"></div>
<div class="row row-cols-1 row-cols-md-3 g-3">
<div class="col">
<div class="card h-100 border-0 text-center" style="border-radius: 14px;">
