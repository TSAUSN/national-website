<li class="col d-flex flex-column align-items-start" style="gap: .6rem; min-width: 0;"><span class="fw-bold d-inline-flex align-items-center justify-content-center flex-shrink-0" style="background-color: #002056; border-radius: 50%; color: #fff; font-size: .9rem; height: 36px; width: 36px;">2</span>
<div style="min-width: 0;">
<h3 class="text-uppercase fw-bold" style="color: #002056; font-size: .95rem; letter-spacing: .04em; margin: 0 0 .5rem;">Treatment</h3>
<p class="mb-0 text-muted" style="font-size: .9rem; line-height: 1.6;">Harbor Light Residential<br>Pinehurst Women's Program</p>
</div>
</li>
<li class="col d-flex flex-column align-items-start" style="gap: .6rem; min-width: 0;"><span class="fw-bold d-inline-flex align-items-center justify-content-center flex-shrink-0" style="background-color: #002056; border-radius: 50%; color: #fff; font-size: .9rem; height: 36px; width: 36px;">3</span>
<div style="min-width: 0;">
