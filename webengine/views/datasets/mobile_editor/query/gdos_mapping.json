{{$totalItems = 0}}


{
    "data": [
        {{each gdos_category_map as gdos}}
        {
            "gdos_category": "{{gdos.gdos_category}}",
            "gdos_subcategory": "{{gdos.gdos_subcategory}}",
            "service_type":  
                {{each service_types as service WHERE service.zuid = '{gdos.service_type}' }}
                {
                    "zuid": "{{service.zuid}}",
                    "title": "{{service.title}}",
                    "description": "{{service.description.escapeForJs()}}",
                    "image": "{{service.image.getMediaURL()}}"
                }
                {{service._arraycomma}}
                {{/each}}
        }
        {{gdos._arraycomma}}
        {{$totalItems = {gdos._num} }}
        {{/each}}
    ],
    "meta": {
        "total_items": {{$totalItems}}
    }
}