{{$zuid = {request.queryParam(zuid)} }}
{{$modelZuid = {request.queryParam(model)} }}

{{$hasList = 0 }}
{{if {$modelZuid} == '6-80c7e29486-k0pq6s' }}
    {{each stories as item WHERE z.zuid = '{$zuid}' LIMIT 1 }}
        {{$locationZUIDs = {item.property} }}
        {{$hasList = 1 }}
    {{/each}}
{{else-if {$modelZuid} == '6-a2dbc1a6e2-x4pzmx' }}
    {{each events as item WHERE z.zuid = '{$zuid}' LIMIT 1 }}
        {{$locationZUIDs = {item.property} }}
        {{$hasList = 1 }}
    {{/each}}
{{/if}}

{{$hasLoc = 0 }}
{{$multiLoc = 0 }}
{{$multiDiv = 0 }}
{{$multiTer = 0 }}
{{if {$hasList} == 1 }}
    {{each locations as loc WHERE find_in_set(z.zuid, '{$locationZUIDs}') }}
        {{if {$hasLoc} == 1 }}
            {{$multiLoc = 1 }}
            {{if {$multiDiv} == 0 }}
                {{$sameDiv = 0 }}
                {{if {loc.division} == {$divZUID} }}{{$sameDiv = 1 }}{{/if}}
                {{if {$sameDiv} == 0 }}{{$multiDiv = 1 }}{{/if}}
            {{/if}}
            {{if {$multiTer} == 0 }}
                {{$sameTer = 0 }}
                {{if {loc.territory} == {$terZUID} }}{{$sameTer = 1 }}{{/if}}
                {{if {$sameTer} == 0 }}{{$multiTer = 1 }}{{/if}}
            {{/if}}
        {{else}}
            {{$hasLoc = 1 }}
            {{$locZUID = {loc.zuid} }}
            {{$divZUID = {loc.division} }}
            {{$terZUID = {loc.territory} }}
            {{if !{$divZUID} }}{{$multiDiv = 1 }}{{/if}}
            {{if !{$terZUID} }}{{$multiTer = 1 }}{{/if}}
        {{/if}}
    {{/each}}
{{/if}}

{{$emitted = 0 }}
{
{{if {$hasLoc} == 1 }}
    {{if {$multiLoc} == 0 }}
        {{each locations as o WHERE z.zuid = '{$locZUID}' LIMIT 1 }}
            {{$emitted = 1 }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
            {{if !{$stateZUID} }}{{if {$divZUID} }}{{$stateZUID = {divisions.filter(z.zuid = '{$divZUID}').state} }}{{/if}}{{/if}}
            {{if !{$stateZUID} }}{{if {$terZUID} }}{{$stateZUID = {territories.filter(z.zuid = '{$terZUID}').state} }}{{/if}}{{/if}}
    "event_found_at": "locations",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "property_type": "{{o.page_layout.escapeForJs()}}",
    "divisionZUID": "{{if {$divZUID} }}{{$divZUID}}{{/if}}",
    "divisionName": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').name.escapeForJs()}}{{/if}}",
    "territoryZUID": "{{if {$terZUID} }}{{$terZUID}}{{/if}}",
    "territoryName": "{{if {$terZUID} }}{{territories.filter(z.zuid = '{$terZUID}').name.escapeForJs()}}{{/if}}",
    "address": "{{o.address.escapeForJs()}}",
    "city": "{{if {$cityZUID} }}{{cities.filter(z.zuid = '{$cityZUID}').title.escapeForJs()}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{states.filter(z.zuid = '{$stateZUID}').name.escapeForJs()}}{{/if}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    "contact_us": [
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        },
        {
            "image": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').contact_us_image.getImage()}}{{/if}}",
            "title": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').contact_us_title.escapeForJs()}}{{/if}}",
            "header": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').contact_us_cta_header.escapeForJs()}}{{/if}}"
        },
        {
            "image": "{{if {$terZUID} }}{{territories.filter(z.zuid = '{$terZUID}').contact_us_image.getImage()}}{{/if}}",
            "title": "{{if {$terZUID} }}{{territories.filter(z.zuid = '{$terZUID}').contact_us_title.escapeForJs()}}{{/if}}",
            "header": "{{if {$terZUID} }}{{territories.filter(z.zuid = '{$terZUID}').contact_us_cta_header.escapeForJs()}}{{/if}}"
        }
    ],
    "donation": [
        {
            "once": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').classy_url.escapeForJs()}}{{/if}}",
            "monthly": "{{if {$divZUID} }}{{divisions.filter(z.zuid = '{$divZUID}').classy_url_mobile.escapeForJs()}}{{/if}}"
        },
        {
            "once": "{{o.classy_url.escapeForJs()}}",
            "monthly": "{{o.classy_url_mobile.escapeForJs()}}"
        }
    ]
        {{/each}}
    {{else-if {$multiDiv} == 0 }}
        {{each divisions as o WHERE z.zuid = '{$divZUID}' LIMIT 1 }}
            {{$emitted = 1 }}
            {{$divTerZUID = {o.territory} }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
            {{if !{$stateZUID} }}{{if {$divTerZUID} }}{{$stateZUID = {territories.filter(z.zuid = '{$divTerZUID}').state} }}{{/if}}{{/if}}
    "event_found_at": "divisions",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "territoryZUID": "{{if {$divTerZUID} }}{{$divTerZUID}}{{/if}}",
    "territoryName": "{{if {$divTerZUID} }}{{territories.filter(z.zuid = '{$divTerZUID}').name.escapeForJs()}}{{/if}}",
    "address": "{{o.address.escapeForJs()}}",
    "city": "{{if {$cityZUID} }}{{cities.filter(z.zuid = '{$cityZUID}').title.escapeForJs()}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{states.filter(z.zuid = '{$stateZUID}').name.escapeForJs()}}{{/if}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    "contact_us": [
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        },
        {
            "image": "{{if {$divTerZUID} }}{{territories.filter(z.zuid = '{$divTerZUID}').contact_us_image.getImage()}}{{/if}}",
            "title": "{{if {$divTerZUID} }}{{territories.filter(z.zuid = '{$divTerZUID}').contact_us_title.escapeForJs()}}{{/if}}",
            "header": "{{if {$divTerZUID} }}{{territories.filter(z.zuid = '{$divTerZUID}').contact_us_cta_header.escapeForJs()}}{{/if}}"
        }
    ],
    "donation": [
        {
            "once": "{{o.classy_url.escapeForJs()}}",
            "monthly": "{{o.classy_url_mobile.escapeForJs()}}"
        }
    ]
        {{/each}}
    {{else-if {$multiTer} == 0 }}
        {{each territories as o WHERE z.zuid = '{$terZUID}' LIMIT 1 }}
            {{$emitted = 1 }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
    "event_found_at": "territories",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "territoryZUID": "{{o.zuid}}",
    "territoryName": "{{o.name.escapeForJs()}}",
    "address": "{{o.address.escapeForJs()}}",
    "city": "{{if {$cityZUID} }}{{cities.filter(z.zuid = '{$cityZUID}').title.escapeForJs()}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{states.filter(z.zuid = '{$stateZUID}').name.escapeForJs()}}{{/if}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    "contact_us": [
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        }
    ],
    "donation": []
        {{/each}}
    {{/if}}
{{/if}}
{{if {$emitted} == 0 }}
    "event_found_at": ""
{{/if}}
}
