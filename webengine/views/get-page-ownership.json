{{$zuid = {request.queryParam(zuid)} }}
{{$modelZuid = {request.queryParam(model)} }}

{{$hasList = 0 }}
{{if {$modelZuid} == '6-80c7e29486-k0pq6s' }}
    {{each stories as item WHERE z.zuid = '{$zuid}' LIMIT 1 }}
        {{$locationZUIDs = {item.property} }}
        {{$hasList = 1 }}
    {{/each}}
{{else-if {$modelZuid} == '6-a2dbc1a6e2-x4pzmx' }}
    {{each events as item WHERE z.zuid = '{$zuid}' LIMIT 1 }}
        {{$locationZUIDs = {item.property} }}
        {{$hasList = 1 }}
    {{/each}}
{{/if}}

{{$hasLoc = 0 }}
{{$multiLoc = 0 }}
{{$multiDiv = 0 }}
{{$multiTer = 0 }}
{{if {$hasList} == 1 }}
    {{each locations as loc WHERE find_in_set(z.zuid, '{$locationZUIDs}') }}
        {{if {$hasLoc} == 1 }}
            {{$multiLoc = 1 }}
            {{if {$multiDiv} == 0 }}
                {{$sameDiv = 0 }}
                {{if {loc.division} == {$divZUID} }}{{$sameDiv = 1 }}{{/if}}
                {{if {$sameDiv} == 0 }}{{$multiDiv = 1 }}{{/if}}
            {{/if}}
            {{if {$multiTer} == 0 }}
                {{$sameTer = 0 }}
                {{if {loc.territory} == {$terZUID} }}{{$sameTer = 1 }}{{/if}}
                {{if {$sameTer} == 0 }}{{$multiTer = 1 }}{{/if}}
            {{/if}}
        {{else}}
            {{$hasLoc = 1 }}
            {{$locZUID = {loc.zuid} }}
            {{$divZUID = {loc.division} }}
            {{$terZUID = {loc.territory} }}
            {{if !{$divZUID} }}{{$multiDiv = 1 }}{{/if}}
            {{if !{$terZUID} }}{{$multiTer = 1 }}{{/if}}
        {{/if}}
    {{/each}}
{{/if}}

{{$ownerLevel = 0 }}
{{if {$hasLoc} == 1 }}
    {{if {$multiLoc} == 0 }}
        {{each locations as o WHERE z.zuid = '{$locZUID}' LIMIT 1 }}
            {{$ownerLevel = 1 }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
        {{/each}}
        {{if {$ownerLevel} == 1 }}
            {{if !{$stateZUID} }}{{if {$divZUID} }}
                {{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{$stateZUID = {d.state} }}{{/each}}
            {{/if}}{{/if}}
            {{if !{$stateZUID} }}{{if {$terZUID} }}
                {{each territories as t WHERE z.zuid = '{$terZUID}' LIMIT 1 }}{{$stateZUID = {t.state} }}{{/each}}
            {{/if}}{{/if}}
        {{/if}}
    {{else-if {$multiDiv} == 0 }}
        {{each divisions as o WHERE z.zuid = '{$divZUID}' LIMIT 1 }}
            {{$ownerLevel = 2 }}
            {{$divTerZUID = {o.territory} }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
        {{/each}}
        {{if {$ownerLevel} == 2 }}
            {{if !{$stateZUID} }}{{if {$divTerZUID} }}
                {{each territories as t WHERE z.zuid = '{$divTerZUID}' LIMIT 1 }}{{$stateZUID = {t.state} }}{{/each}}
            {{/if}}{{/if}}
        {{/if}}
    {{else-if {$multiTer} == 0 }}
        {{each territories as o WHERE z.zuid = '{$terZUID}' LIMIT 1 }}
            {{$ownerLevel = 3 }}
            {{$cityZUID = {o.city} }}
            {{$stateZUID = {o.state} }}
        {{/each}}
    {{/if}}
{{/if}}

{
{{if {$ownerLevel} == 1 }}
    {{each locations as o WHERE z.zuid = '{$locZUID}' LIMIT 1 }}
    "event_found_at": "locations",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "property_type": "{{o.page_layout.escapeForJs()}}",
    "address": "{{o.address.escapeForJs()}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    {{/each}}
    "divisionZUID": "{{if {$divZUID} }}{{$divZUID}}{{/if}}",
    "divisionName": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.name.escapeForJs()}}{{/each}}{{/if}}",
    "territoryZUID": "{{if {$terZUID} }}{{$terZUID}}{{/if}}",
    "territoryName": "{{if {$terZUID} }}{{each territories as t WHERE z.zuid = '{$terZUID}' LIMIT 1 }}{{t.name.escapeForJs()}}{{/each}}{{/if}}",
    "city": "{{if {$cityZUID} }}{{each cities as c WHERE z.zuid = '{$cityZUID}' LIMIT 1 }}{{c.title.escapeForJs()}}{{/each}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{each states as s WHERE z.zuid = '{$stateZUID}' LIMIT 1 }}{{s.name.escapeForJs()}}{{/each}}{{/if}}",
    "contact_us": [
        {{each locations as o WHERE z.zuid = '{$locZUID}' LIMIT 1 }}
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        },
        {{/each}}
        {
            "image": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.contact_us_image.getImage()}}{{/each}}{{/if}}",
            "title": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.contact_us_title.escapeForJs()}}{{/each}}{{/if}}",
            "header": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.contact_us_cta_header.escapeForJs()}}{{/each}}{{/if}}"
        },
        {
            "image": "{{if {$terZUID} }}{{each territories as t WHERE z.zuid = '{$terZUID}' LIMIT 1 }}{{t.contact_us_image.getImage()}}{{/each}}{{/if}}",
            "title": "{{if {$terZUID} }}{{each territories as t WHERE z.zuid = '{$terZUID}' LIMIT 1 }}{{t.contact_us_title.escapeForJs()}}{{/each}}{{/if}}",
            "header": "{{if {$terZUID} }}{{each territories as t WHERE z.zuid = '{$terZUID}' LIMIT 1 }}{{t.contact_us_cta_header.escapeForJs()}}{{/each}}{{/if}}"
        }
    ],
    "donation": [
        {
            "once": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.classy_url.escapeForJs()}}{{/each}}{{/if}}",
            "monthly": "{{if {$divZUID} }}{{each divisions as d WHERE z.zuid = '{$divZUID}' LIMIT 1 }}{{d.classy_url_mobile.escapeForJs()}}{{/each}}{{/if}}"
        },
        {{each locations as o WHERE z.zuid = '{$locZUID}' LIMIT 1 }}
        {
            "once": "{{o.classy_url.escapeForJs()}}",
            "monthly": "{{o.classy_url_mobile.escapeForJs()}}"
        }
        {{/each}}
    ]
{{else-if {$ownerLevel} == 2 }}
    {{each divisions as o WHERE z.zuid = '{$divZUID}' LIMIT 1 }}
    "event_found_at": "divisions",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "address": "{{o.address.escapeForJs()}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    "donation": [
        {
            "once": "{{o.classy_url.escapeForJs()}}",
            "monthly": "{{o.classy_url_mobile.escapeForJs()}}"
        }
    ],
    {{/each}}
    "territoryZUID": "{{if {$divTerZUID} }}{{$divTerZUID}}{{/if}}",
    "territoryName": "{{if {$divTerZUID} }}{{each territories as t WHERE z.zuid = '{$divTerZUID}' LIMIT 1 }}{{t.name.escapeForJs()}}{{/each}}{{/if}}",
    "city": "{{if {$cityZUID} }}{{each cities as c WHERE z.zuid = '{$cityZUID}' LIMIT 1 }}{{c.title.escapeForJs()}}{{/each}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{each states as s WHERE z.zuid = '{$stateZUID}' LIMIT 1 }}{{s.name.escapeForJs()}}{{/each}}{{/if}}",
    "contact_us": [
        {{each divisions as o WHERE z.zuid = '{$divZUID}' LIMIT 1 }}
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        },
        {{/each}}
        {
            "image": "{{if {$divTerZUID} }}{{each territories as t WHERE z.zuid = '{$divTerZUID}' LIMIT 1 }}{{t.contact_us_image.getImage()}}{{/each}}{{/if}}",
            "title": "{{if {$divTerZUID} }}{{each territories as t WHERE z.zuid = '{$divTerZUID}' LIMIT 1 }}{{t.contact_us_title.escapeForJs()}}{{/each}}{{/if}}",
            "header": "{{if {$divTerZUID} }}{{each territories as t WHERE z.zuid = '{$divTerZUID}' LIMIT 1 }}{{t.contact_us_cta_header.escapeForJs()}}{{/each}}{{/if}}"
        }
    ]
{{else-if {$ownerLevel} == 3 }}
    {{each territories as o WHERE z.zuid = '{$terZUID}' LIMIT 1 }}
    "event_found_at": "territories",
    "zuid": "{{o.zuid}}",
    "path": "{{truepath({o.zuid})}}",
    "name": "{{o.name.escapeForJs()}}",
    "territoryZUID": "{{o.zuid}}",
    "territoryName": "{{o.name.escapeForJs()}}",
    "address": "{{o.address.escapeForJs()}}",
    "zipcode": "{{o.zipcode.escapeForJs()}}",
    "contact_us": [
        {
            "image": "{{o.contact_us_image.getImage()}}",
            "title": "{{o.contact_us_title.escapeForJs()}}",
            "header": "{{o.contact_us_cta_header.escapeForJs()}}"
        }
    ],
    "donation": [],
    {{/each}}
    "city": "{{if {$cityZUID} }}{{each cities as c WHERE z.zuid = '{$cityZUID}' LIMIT 1 }}{{c.title.escapeForJs()}}{{/each}}{{/if}}",
    "state": "{{if {$stateZUID} }}{{each states as s WHERE z.zuid = '{$stateZUID}' LIMIT 1 }}{{s.name.escapeForJs()}}{{/each}}{{/if}}"
{{else}}
    "event_found_at": ""
{{/if}}
}
