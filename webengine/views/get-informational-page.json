{{$zuid = {request.queryParam(zuid)} }}

{{each informational_pages as ip WHERE z.zuid = '{$zuid}' LIMIT 1}}
    {{$ipParentLocation = {informational_pages.filter({ip.parent_zuid}).location} }}
    {{$ipParentDivision = {informational_pages.filter({ip.parent_zuid}).division} }}
    {{$ipParentTerritory = {informational_pages.filter({ip.parent_zuid}).territory} }}
    {
        {{if {ip.location} }}
            {{$cityZUID = {locations.filter({ip.location}).city} }}
            {{$stateZUID = {locations.filter({ip.location}).state} }}
            "content": {{ locations.filter({ip.location}).toJSON() }},
            "address": "{{ locations.filter({ip.location}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{else-if {ip.division} }}
            {{$cityZUID = {divisions.filter({ip.division}).city} }}
            {{$stateZUID = {divisions.filter({ip.division}).state} }}
            "content": {{ divisions.filter({ip.division}).toJSON() }},
            "address": "{{ divisions.filter({ip.division}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{else-if {ip.territory} }}
            {{$cityZUID = {territories.filter({ip.territory}).city} }}
            {{$stateZUID = {territories.filter({ip.territory}).state} }}
            "content": {{ territories.filter({ip.territory}).toJSON() }},
            "address": "{{ territories.filter({ip.territory}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{else-if {$ipParentLocation} }}
            {{$cityZUID = {locations.filter({$ipParentLocation}).city} }}
            {{$stateZUID = {locations.filter({$ipParentLocation}).state} }}
            "content": {{ locations.filter({$ipParentLocation}).toJSON() }},
            "address": "{{ locations.filter({$ipParentLocation}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{else-if {$ipParentDivision} }}
            {{$cityZUID = {divisions.filter({$ipParentDivision}).city} }}
            {{$stateZUID = {divisions.filter({$ipParentDivision}).state} }}
            "content": {{ divisions.filter({$ipParentDivision}).toJSON() }},
            "address": "{{ divisions.filter({$ipParentDivision}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{else-if {$ipParentTerritory} }}
            {{$cityZUID = {territories.filter({$ipParentTerritory}).city} }}
            {{$stateZUID = {territories.filter({$ipParentTerritory}).state} }}
            "content": {{ territories.filter({$ipParentTerritory}).toJSON() }},
            "address": "{{ territories.filter({$ipParentTerritory}).address }}",
            "city": "{{cities.filter({$cityZUID}).title }}",
            "state": "{{states.filter({$stateZUID}).name }}"
        {{/if}}
    }
{{/each}}