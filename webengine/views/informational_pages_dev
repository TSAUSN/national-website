<h1>
    Informational DEV
</h1>

<script>
    (async function loadCurrentInformationalPage() {
        try {
            // Capture the incoming location before initCookies resolves the
            // context for this informational page.
            const persistedZuid = cookieManager.get(cookieKeys.locationZUID);

            if (window.cookiesReady && typeof window.cookiesReady.then === 'function') {
                await window.cookiesReady;
            }

            const locationZuid = persistedZuid || cookieManager.get(cookieKeys.locationZUID);

            if (locationZuid) {
                const linksQuery = new URLSearchParams({
                    zuid: locationZuid
                });
                const linksRes = await fetch(
                    `/get-informational-page-links-dev.json?${linksQuery.toString()}`,
                    { credentials: 'same-origin' }
                );

                console.log('[Informational DEV] links endpoint status', {
                    ok: linksRes.ok,
                    status: linksRes.status,
                    statusText: linksRes.statusText
                });

                if (linksRes.ok) {
                    const links = await linksRes.json();
                    console.log('[Informational DEV] links endpoint response', links);
                }
            } else {
                console.warn('[Informational DEV] links endpoint skipped: no location ZUID');
            }

            const query = new URLSearchParams({
                zuid: `{{this.zuid}}`
            });

            if (persistedZuid) {
                query.set('persisted_zuid', persistedZuid);
            }

            const res = await fetch(
                `/get-informational-page.json?${query.toString()}`,
                { credentials: 'same-origin' }
            );

            if (!res.ok) {
                throw new Error(`Request failed with status ${res.status}`);
            }

            const body = await res.json();
            console.log({
                persistedZuid,
                currentInformation: body
            });
        } catch (err) {
            console.error('Unable to load the current informational page:', err);
        }
    })();
</script>
