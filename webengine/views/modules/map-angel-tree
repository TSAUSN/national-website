<script>
let map = null;
let items = [];

const REGISTRY_TYPE_ONLINE = 'online';
const REGISTRY_TYPE_STORE = 'store';

// null until the user makes their one-time registry-type choice
let activeRegistryType = null;
let currentResults = { [REGISTRY_TYPE_ONLINE]: [], [REGISTRY_TYPE_STORE]: [] };
let lastSearchCenter = null;
let lastSearchTerm = '';

const REGISTRY_TYPE_CONFIG = {
  [REGISTRY_TYPE_ONLINE]: {
    badgeLabel: 'Online',
    color: '#12825F',
    headingText: "Find a Salvation Army unit and shop their registry online",
    emptyText: 'No online registries found within 50 miles. Try a different address.',
    countLabel: (n) => `${n} Salvation Army ${n === 1 ? 'unit' : 'units'} near you`
  },
  [REGISTRY_TYPE_STORE]: {
    badgeLabel: 'In Store',
    color: '#2F6FED',
    headingText: "Find a participating Walmart or Sam's Club near you",
    emptyText: 'No physical stores found within 50 miles. Try a different address.',
    countLabel: (n) => `${n} participating ${n === 1 ? 'store' : 'stores'} near you`
  }
};

// OPTIMIZED BATCH GEOCODER - Only for user input address
const createOptimizedBatchGeocoder = (rateLimitMs = 10) => {
  let geocoder = null;

  const initialize = () => {
    if (window.google && window.google.maps) {
      geocoder = new google.maps.Geocoder();
      return true;
    }
    return false;
  };

  const geocodeSingle = async (address) => {
    return new Promise((resolve) => {
      const delay = Math.random() * rateLimitMs;

      setTimeout(() => {
        geocoder.geocode({ address }, (results, status) => {
          let result = null;
          if (status === google.maps.GeocoderStatus.OK && results?.length > 0) {
            result = {
              lat: results[0].geometry.location.lat(),
              lng: results[0].geometry.location.lng(),
              formatted_address: results[0].formatted_address
            };
          }

          resolve(result);
        });
      }, delay);
    });
  };

  // Method for single address geocoding (for search functionality)
  const geocodeWithRateLimit = async (address) => {
    if (!geocoder && !initialize()) {
      throw new Error('Google Maps API not ready');
    }

    return geocodeSingle(address);
  };

  return { initialize, geocodeWithRateLimit };
};

const batchGeocoder = createOptimizedBatchGeocoder();

// Field ID mapping per registry type (QuickBase field IDs differ between
// the online registry table and the in-store/Walmart table)
const REGISTRY_FIELD_MAP = {
  [REGISTRY_TYPE_ONLINE]: {
    name: 15, address: 121, city: 122, state: 31, zip: 160,
    lat: 156, long: 157, division: 16, url: 32
  },
  [REGISTRY_TYPE_STORE]: {
    name: 23, address: 25, city: 26, state: 149, zip: 8,
    lat: 177, long: 178, division: 16, url: null
  }
};

// Build address string for location identification
const buildAddressString = (location, fieldMap) => {
  const parts = [];
  if (location[fieldMap.address]?.value) parts.push(location[fieldMap.address].value);
  if (location[fieldMap.city]?.value) parts.push(location[fieldMap.city].value);
  if (location[fieldMap.state]?.value) parts.push(location[fieldMap.state].value);
  if (location[fieldMap.zip]?.value) parts.push(location[fieldMap.zip].value);
  return parts.length > 0 ? parts.join(', ') : '';
};

// SIMPLIFIED LOCATION PROCESSOR - tags each location with its registry type
const createSimpleLocationProcessor = (registryType) => {
  const fieldMap = REGISTRY_FIELD_MAP[registryType];

  const processLocations = (locations) => {
    return locations
      .map(location => {
        // Check if location has required coordinate fields
        if (!location[fieldMap.lat] || !location[fieldMap.long]) {
          return null;
        }

        const orgDetails = `SAL^${location[fieldMap.division]?.value}` || 'SAL';
        const fullAddress = buildAddressString(location, fieldMap);

        // Skip locations without address info
        if (!fullAddress) {
          return null;
        }

        return {
          ...location,
          type: registryType,
          fullAddress,
          coordinates: {
            lat: parseFloat(location[fieldMap.lat].value),
            lng: parseFloat(location[fieldMap.long].value)
          },
          displayName: location[fieldMap.name]?.value || 'Unknown Location',
          giveUrl: fieldMap.url ? (location[fieldMap.url]?.value || '') : '',
          organization_details: orgDetails
        };
      })
      .filter(Boolean);
  };

  return { processLocations };
};

// SIMPLIFIED PREPROCESSING FUNCTION
const preprocessLocationDataOptimized = async (locations, registryType) => {
  console.log(`Starting simplified preprocessing for ${registryType}...`);
  const startTime = Date.now();

  const processor = createSimpleLocationProcessor(registryType);
  const processedLocations = processor.processLocations(locations);

  const endTime = Date.now();
  const processingTime = (endTime - startTime) / 1000;
  console.log(`Preprocessing complete: ${processedLocations.length} ${registryType} locations processed in ${processingTime.toFixed(2)}s`);

  return processedLocations;
};

// Optimized filtering with pre-stored coordinates
const filterLocationsByRadius = async (processedLocations, inputLocation, radiusMiles = 50) => {
  console.log("Input Text", inputLocation);
  if (!processedLocations?.length) {
    throw new Error('No processed locations available');
  }

  // Get center coordinates (this is the only geocoding call during search)
  const centerCoordinates = await batchGeocoder.geocodeWithRateLimit(inputLocation);
  if (!centerCoordinates) {
    throw new Error('Could not geocode input location');
  }

  // Filter using pre-stored coordinates
  const filteredLocations = processedLocations
    .map(location => {
      const distance = calculateLocationDistance(
        centerCoordinates.lat,
        centerCoordinates.lng,
        location.coordinates.lat,
        location.coordinates.lng
      );

      return {
        ...location,
        distanceFromCenter: Math.round(distance * 100) / 100
      };
    })
    .filter(location => location.distanceFromCenter <= radiusMiles)
    .sort((a, b) => a.distanceFromCenter - b.distanceFromCenter);

  return { filteredLocations, centerCoordinates };
};

// Colored pin icon, per registry type
const createPinIcon = (color) => {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40">
    <path d="M20 2C13.37 2 8 7.37 8 14c0 8.75 12 24 12 24s12-15.25 12-24c0-6.63-5.37-12-12-12zm0 16.5c-2.49 0-4.5-2.01-4.5-4.5S17.51 9.5 20 9.5 24.5 11.51 24.5 14 22.49 18.5 20 18.5z" fill="${color}" stroke="#FFFFFF" stroke-width="1"/>
  </svg>`;
  return {
    url: 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg),
    origin: new google.maps.Point(0, 0),
    anchor: new google.maps.Point(20, 40),
    scaledSize: new google.maps.Size(40, 40)
  };
};

const markerPool = (() => {
  const activeMarkers = [];

  const addMarker = (mapInstance, lat, lng, title, icon) => {
    const marker = new google.maps.Marker({ position: { lat, lng }, map: mapInstance, title, icon });
    activeMarkers.push(marker);
    return marker;
  };

  const clearAllMarkers = () => {
    activeMarkers.forEach(marker => marker.setMap(null));
    activeMarkers.length = 0;
  };

  return { addMarker, clearAllMarkers };
})();

// Calculate distance (unchanged)
const calculateLocationDistance = (lat1, lon1, lat2, lon2) => {
  const R = 3959; // Earth's radius in miles
  const dLat = toRadians(lat2 - lat1);
  const dLon = toRadians(lon2 - lon1);

  const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) *
    Math.sin(dLon / 2) * Math.sin(dLon / 2);

  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c;
};

const toRadians = (degrees) => degrees * (Math.PI / 180);

// Card generation - differentiates online registries from physical stores
const generateCards = (locations, registryType, analyticsObject) => {
  const config = REGISTRY_TYPE_CONFIG[registryType];

  return locations.map((location, index) => {
    const cta = registryType === REGISTRY_TYPE_ONLINE
      ? `<a
          class="btn btn-primary btn-sm fw-bold px-4 py-2 text-uppercase fs-6 display-3"
          target="_blank"
          href="${location.giveUrl || '#'}"
          data-link-location-type="body:map"
          data-link-function-type="other"
          data-link-format-type="button"
          data-link-type="external"
          data-location-name="${location.displayName}"
          data-location-search-term="${analyticsObject.search_term}"
          data-location-search-results="${analyticsObject.total_results}"
          data-location-search-type="location search - body"
          data-location-search-method-type="user-entered"
          data-location-search-result-index="${index}"
          onclick="LocationTrackingResultsClickEvent(this, 'angel_tree_result_click')"
        >View Registry</a>`
      : `<a
          class="btn btn-outline-primary btn-sm fw-bold px-4 py-2 text-uppercase fs-6 display-3"
          target="_blank"
          href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.fullAddress)}"
          data-link-location-type="body:map"
          data-link-function-type="other"
          data-link-format-type="button"
          data-link-type="external"
          data-location-name="${location.displayName}"
          data-location-search-term="${analyticsObject.search_term}"
          data-location-search-results="${analyticsObject.total_results}"
          data-location-search-type="location search - body"
          data-location-search-method-type="user-entered"
          data-location-search-result-index="${index}"
          onclick="LocationTrackingResultsClickEvent(this, 'angel_tree_result_click')"
        >Get Directions</a>`;

    return `<div class="angel-tree__items card mb-2 mt-2" data-id="${index}" data-type="${registryType}">
      <div class="card-body">
        <span class="badge mb-2" style="background-color:${config.color}">${config.badgeLabel}</span>
        <div class="d-flex justify-content-between align-items-center">
          <div class="col-7 justify-content-center">
            <h5 class="card-title fw-bold text-secondary-200 mb-1 display-2">
              ${location.displayName}
            </h5>
            <p class="text-muted mb-0 display-3">${location.fullAddress}</p>
            <p class="text-muted mb-0 display-3">${location.distanceFromCenter} mi away</p>
          </div>
          <div class="col-5 text-end justify-content-center">
            ${cta}
          </div>
        </div>
      </div>
    </div>`;
  }).join('');
};

// Function to handle marker click and card interaction
const handleMarkerClick = (markerId) => {
  const cardsContainer = document.querySelector('#angel-tree-result');

  // Remove active class from all cards
  const allCards = cardsContainer.querySelectorAll('.angel-tree__items');
  allCards.forEach((card) => {
    card.classList.remove('active');
    card.classList.remove('bg-primary-50');
  });

  // Find and activate the corresponding card
  const targetCard = cardsContainer.querySelector(`[data-id="${markerId}"]`);
  if (targetCard) {
    targetCard.classList.add('active');
    targetCard.classList.add('bg-primary-50');

    const scrollTop = targetCard.offsetTop - cardsContainer.offsetTop - 10;

    cardsContainer.scrollTo({
      top: scrollTop,
      behavior: 'smooth'
    });
  }
};

// Render the currently selected registry type's markers + result cards
const renderActiveType = () => {
  const cardsContainer = document.querySelector('#angel-tree-result');
  const headerEl = document.querySelector('#angel-tree-results-header');
  const countEl = document.querySelector('#angel-tree-results-count');
  const config = REGISTRY_TYPE_CONFIG[activeRegistryType];
  const list = currentResults[activeRegistryType] || [];

  markerPool.clearAllMarkers();

  if (list.length > 0) {
    const icon = createPinIcon(config.color);
    const analyticsObject = { search_term: lastSearchTerm, total_results: list.length };

    list.forEach((item, index) => {
      const marker = markerPool.addMarker(map, item.coordinates.lat, item.coordinates.lng, item.displayName, icon);

      marker.addListener('click', function () {
        handleMarkerClick(index);
        const searchInfo = {
          searchTerm: lastSearchTerm,
          totalResults: list.length,
          searchMethod: 'user-entered',
          filterType: activeRegistryType,
          filterValue: activeRegistryType
        };
        const locationData = {
          resultIndex: index || '1',
          location_id: item.id || '',
          name: item.displayName,
          location_org_detail: item.organization_details || ''
        };

        LocationTrackingMapClickEvent(locationData, searchInfo, 'angel_tree_map_click');
      });
    });

    cardsContainer.innerHTML = generateCards(list, activeRegistryType, analyticsObject);
    if (headerEl) headerEl.classList.remove('d-none');
    if (countEl) countEl.textContent = config.countLabel(list.length);
  } else {
    cardsContainer.innerHTML = `<p class="p-3">${config.emptyText}</p>`;
    if (headerEl) headerEl.classList.add('d-none');
  }

  if (lastSearchCenter) {
    map.setZoom(10);
    map.setCenter(lastSearchCenter);
  }
};

// Wires up the "Online registry" / "In store" buttons. The choice is a
// one-time lock: once picked, the other option disappears and there is no
// way back short of reloading the page.
const setupRegistryTypeToggle = () => {
  const buttons = document.querySelectorAll('#angel-tree-type-toggle button[data-registry-type]');

  buttons.forEach(btn => {
    btn.addEventListener('click', function () {
      if (activeRegistryType) return; // already locked in
      selectRegistryType(this.dataset.registryType);
    });
  });
};

// Locks in the chosen registry type: updates the toggle UI, reveals the
// search controls, and fetches only that type's dataset.
const selectRegistryType = async (type) => {
  if (activeRegistryType) return;
  activeRegistryType = type;

  const otherType = type === REGISTRY_TYPE_ONLINE ? REGISTRY_TYPE_STORE : REGISTRY_TYPE_ONLINE;
  const heading = document.querySelector('#angel-tree-heading');
  const label = document.querySelector('#angel-tree-type-label');
  const searchControls = document.querySelector('#angel-tree-search-controls');
  const emptyState = document.querySelector('#angel-tree-map-empty-state');
  const otherCol = document.querySelector(`#angel-tree-type-col-${otherType}`);
  const selectedCol = document.querySelector(`#angel-tree-type-col-${type}`);
  const selectedBtn = selectedCol?.querySelector('button');

  if (otherCol) otherCol.classList.add('d-none');
  if (selectedCol) {
    selectedCol.classList.remove('col-6');
    selectedCol.classList.add('col-12');
  }
  if (selectedBtn) {
    selectedBtn.classList.add('active', 'locked');
    selectedBtn.setAttribute('aria-disabled', 'true');
    selectedBtn.tabIndex = -1;
  }
  if (heading) heading.textContent = REGISTRY_TYPE_CONFIG[type].headingText;
  if (label) label.textContent = 'Showing';
  if (searchControls) searchControls.classList.remove('d-none');
  if (emptyState) emptyState.classList.add('d-none');

  const loader = document.querySelector('.map-loader');
  const submitBtn = document.querySelector('#angel-tree__search-btn');

  if (loader) loader.classList.remove('d-none');

  try {
    const rawData = type === REGISTRY_TYPE_ONLINE
      ? await getOnlineRegistryData()
      : await getPhysicalStoreData();

    const processedData = await preprocessLocationDataOptimized(rawData, type);
    items = { processedData };

    if (submitBtn) submitBtn.removeAttribute('disabled');
    console.log(`Ready! Processed ${processedData.length} ${type} locations.`);
  } catch (error) {
    console.error('Error loading registry data:', error);
  } finally {
    if (loader) loader.classList.add('d-none');
  }
};

// Data fetching - online registries
const getOnlineRegistryData = async () => {
  try {
    const response = await fetch(`https://api.quickbase.com/v1/records/query`, {
      method: "POST",
      headers: {
        'QB-Realm-Hostname': 'saapps.quickbase.com',
        'Authorization': 'QB-USER-TOKEN ca43nd_mn6f_0_vff9axtcqg3fceraqiic2kasz7',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        "from": "bvxwt6a5d",
        "select": [130, 160, 158, 15, 121, 122, 31, 32, 16, 17, 156, 157, 52, 39],
        "where": "{52.CampaignName.'Online Angel Tree'} AND {39.flag.'Yes'}"
      })
    });

    const { data, fields } = await response.json();
    console.log('Returned Online Registry Data', fields, data);
    return Array.isArray(data) ? data : [];
  } catch (error) {
    console.log("ERROR Angel Tree Online Registry", error.message);
    return [];
  }
};

// Data fetching - physical store / in-person Walmart locations
const getPhysicalStoreData = async () => {
  try {
    const response = await fetch(`https://api.quickbase.com/v1/records/query`, {
      method: "POST",
      headers: {
        'QB-Realm-Hostname': 'saapps.quickbase.com',
        'Authorization': 'QB-USER-TOKEN ca43nd_mn6f_0_vff9axtcqg3fceraqiic2kasz7',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        "from": "bvxwt6a5d",
        "select": [130, 160, 158, 15, 121, 122, 31, 16, 17, 156, 157, 52, 23, 24, 25, 26, 149, 8, 177, 178, 39, 187, 190],
        "where": "{52.CampaignName.'In-Store Angel Tree'} AND {39.flag.'Yes'}"
      })
    });

    const { data, fields } = await response.json();
    console.log('Returned Physical Store Data', fields, data);
    return Array.isArray(data) ? data : [];
  } catch (error) {
    console.log("ERROR Angel Tree Physical Store", error.message);
    return [];
  }
};

// Function to handle "Use My Location" button click
const handleUseMyLocation = async () => {
  const button = document.querySelector('.use-my-location-angel');
  const input = document.querySelector('#angel-tree__input');
  const loader = document.querySelector('.map-loader');

  // Show loading state
  if (button) {
    button.disabled = true;
    button.innerHTML = `
      <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
      Getting Location...
    `;
  }

  if (loader) loader.classList.remove('d-none');

  try {
    if (!navigator.geolocation) {
      throw new Error('Geolocation is not supported by this browser.');
    }

    const position = await new Promise((resolve, reject) => {
      navigator.geolocation.getCurrentPosition(
        resolve,
        reject,
        {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 300000 // 5 minutes
        }
      );
    });

    const { latitude, longitude } = position.coords;
    console.log('Current coordinates:', latitude, longitude);

    const geocoder = new google.maps.Geocoder();

    const geocodeResult = await new Promise((resolve, reject) => {
      geocoder.geocode(
        { location: { lat: latitude, lng: longitude } },
        (results, status) => {
          if (status === google.maps.GeocoderStatus.OK && results?.length > 0) {
            resolve(results[0]);
          } else {
            reject(new Error('Unable to get address from coordinates'));
          }
        }
      );
    });

    const formattedAddress = geocodeResult.formatted_address;
    console.log('Formatted address:', formattedAddress);

    if (input) {
      input.value = formattedAddress;
      const inputEvent = new Event('input', { bubbles: true });
      input.dispatchEvent(inputEvent);
    }

    await new Promise(resolve => setTimeout(resolve, 100));

    await searchAngelTreeLocations();

  } catch (error) {
    console.error('Error getting location:', error);

    let errorMessage = 'Unable to get your location. ';

    if (error.code === 1) {
      errorMessage += 'Location access was denied. Please enable location services and try again.';
    } else if (error.code === 2) {
      errorMessage += 'Location information is unavailable.';
    } else if (error.code === 3) {
      errorMessage += 'Location request timed out. Please try again.';
    } else {
      errorMessage += error.message || 'Please try again or enter your address manually.';
    }

    alert(errorMessage);

  } finally {
    if (button) {
      button.disabled = false;
      button.innerHTML = `
        <span class="material-symbols-outlined me-2">
          my_location
        </span> Use My Location
      `;
    }

    if (loader) loader.classList.add('d-none');
  }
};

// Main search function - runs the radius filter once against both datasets,
// then renders whichever registry type is currently selected
const searchAngelTreeLocations = async () => {
  const loader = document.querySelector('.map-loader');
  const cardsContainer = document.querySelector('#angel-tree-result');
  const mapContentContainer = document.querySelector('#angel-tree-content');
  const input = document.querySelector("#angel-tree__input");
  const inputValue = input.value;

  if (!inputValue) return;

  cardsContainer.setAttribute('style', 'height: 400px; max-height: 400px;');
  cardsContainer.classList.remove('d-none');
  if (mapContentContainer) mapContentContainer.classList.add('d-none');

  if (loader) loader.classList.remove('d-none');

  try {
    markerPool.clearAllMarkers();
    console.log('Locations', items);

    const { filteredLocations, centerCoordinates } = await filterLocationsByRadius(
      items.processedData || [],
      inputValue
    );

    lastSearchCenter = centerCoordinates;
    lastSearchTerm = inputValue;
    currentResults = {
      [REGISTRY_TYPE_ONLINE]: filteredLocations.filter(loc => loc.type === REGISTRY_TYPE_ONLINE),
      [REGISTRY_TYPE_STORE]: filteredLocations.filter(loc => loc.type === REGISTRY_TYPE_STORE)
    };

    map.setZoom(10);
    map.setCenter(centerCoordinates);

    renderActiveType();

    input.setAttribute('data-search-term-type', inputValue);
    input.setAttribute('data-search-filter-type', activeRegistryType);
    input.setAttribute('data-search-results-type', filteredLocations.length);
    input.setAttribute('data-search-method-type', 'user-entered');
    input.setAttribute('data-search-type-type', 'location search - body');

    LocationTrackingSearchEvent(input, 'angel_tree_search');
  } catch (error) {
    console.error('Search error:', error);
    cardsContainer.innerHTML = '<p class="p-3">Error occurred during search. Please try again.</p>';
    const headerEl = document.querySelector('#angel-tree-results-header');
    if (headerEl) headerEl.classList.add('d-none');
  } finally {
    if (loader) loader.classList.add('d-none');
  }
};

function angelTreeInputAddressSuggestion() {
  const input = document.querySelector('#angel-tree__input');

  if (input) {
    let sessionToken = new google.maps.places.AutocompleteSessionToken();
    const autocompleteService = new google.maps.places.AutocompleteService();

    let debounceTimer;
    const debounceDelay = 300;

    const autocompleteContainer = document.createElement('div');
    autocompleteContainer.className = 'autocomplete-dropdown-container-angel-tree';
    autocompleteContainer.style.cssText = `
      position: absolute;
      z-index: 1050;
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      max-height: 280px;
      overflow-y: auto;
      display: none;
      width: 100%;
      margin-top: 4px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    `;

    if (!document.getElementById('autocomplete-styles-angel-tree')) {
      const style = document.createElement('style');
      style.id = 'autocomplete-styles-angel-tree';
      style.textContent = `
        .autocomplete-dropdown-container-angel-tree::-webkit-scrollbar {
          width: 8px;
        }
        .autocomplete-dropdown-container-angel-tree::-webkit-scrollbar-track {
          background: #f1f1f1;
          border-radius: 4px;
        }
        .autocomplete-dropdown-container-angel-tree::-webkit-scrollbar-thumb {
          background: #c1c1c1;
          border-radius: 4px;
        }
        .autocomplete-dropdown-container-angel-tree::-webkit-scrollbar-thumb:hover {
          background: #a8a8a8;
        }
        .autocomplete-item-angel-tree {
          padding: 12px 16px;
          cursor: pointer;
          border-bottom: 1px solid #f3f4f6;
          transition: background-color 0.15s ease;
          display: flex;
          align-items: center;
          gap: 10px;
        }
        .autocomplete-item-angel-tree:last-child {
          border-bottom: none;
        }
        .autocomplete-item-angel-tree:hover {
          background-color: #f9fafb;
        }
        .autocomplete-item-angel-tree:active {
          background-color: #f3f4f6;
        }
        .autocomplete-icon-angel-tree {
          width: 18px;
          height: 18px;
          color: #6b7280;
          flex-shrink: 0;
        }
        .autocomplete-text-angel-tree {
          color: #1f2937;
          font-size: 14px;
          line-height: 1.5;
        }
      `;
      document.head.appendChild(style);
    }

    input.parentNode.style.position = 'relative';
    input.parentNode.appendChild(autocompleteContainer);

    input.addEventListener('input', function () {
      const value = this.value;

      clearTimeout(debounceTimer);

      if (value.length < 3) {
        autocompleteContainer.style.display = 'none';
        return;
      }

      debounceTimer = setTimeout(() => {
        autocompleteService.getPlacePredictions({
          input: value,
          types: ['(regions)'],
          componentRestrictions: { country: 'US' },
          sessionToken: sessionToken
        }, (predictions, status) => {
          if (status === google.maps.places.PlacesServiceStatus.OK && predictions) {
            autocompleteContainer.innerHTML = '';
            autocompleteContainer.style.display = 'block';

            predictions.forEach(prediction => {
              const item = document.createElement('div');
              item.className = 'autocomplete-item-angel-tree';
              item.innerHTML = `
                <svg class="autocomplete-icon-angel-tree" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="autocomplete-text-angel-tree">${prediction.description}</span>
              `;

              item.addEventListener('click', function () {
                input.value = prediction.description;
                autocompleteContainer.style.display = 'none';
                sessionToken = new google.maps.places.AutocompleteSessionToken();
              });
              autocompleteContainer.appendChild(item);
            });
          } else {
            autocompleteContainer.style.display = 'none';
          }
        });
      }, debounceDelay);
    });

    document.addEventListener('click', function (e) {
      if (e.target !== input && !autocompleteContainer.contains(e.target)) {
        autocompleteContainer.style.display = 'none';
      }
    });
  }
}

// Initialize when map is ready. No registry data is fetched here - only
// once the user locks in a registry type via selectRegistryType().
window.addEventListener('mapReady', (event) => {
  map = event.detail.map;

  if (map) {
    try {
      if (!batchGeocoder.initialize()) {
        throw new Error('Failed to initialize Google Maps geocoder');
      }

      angelTreeInputAddressSuggestion();
      setupRegistryTypeToggle();
    } catch (error) {
      console.error('Initialization error:', error);
    }

    const useLocationButton = document.querySelector('.use-my-location-angel');

    if (useLocationButton) {
      useLocationButton.removeEventListener('click', handleUseMyLocation);
      useLocationButton.addEventListener('click', handleUseMyLocation);
    }
  }
});
</script>
