      ,"logo": "{{globals.default_og_image.getImage()}}"
      {{/if}}
    },
    {{else}}
    {
      "@type": "{{if {$schemaOwnerLevel} == 1 }}LocalBusiness{{else}}NGO{{/if}}",
      "@id": "https://www.{{instance.domain}}{{$schemaOrgPath}}#{{$schemaOrgFragment}}",
      "name": "{{if {$orgName} }}{{if {$schemaOwnerLevel} == 1 }}{{$orgName}}{{else}}The Salvation Army {{$orgName}}{{if {$orgAddSuffix} == 1 }} Division{{/if}}{{/if}}{{else}}The Salvation Army{{/if}}",
