        {{if {$orgYoutube} }}{{if {$sameAsSep} == 1 }},{{/if}}"{{$orgYoutube}}"{{$sameAsSep = 1}}{{/if}}
        {{if {$orgLinkedin} }}{{if {$sameAsSep} == 1 }},{{/if}}"{{$orgLinkedin}}"{{$sameAsSep = 1}}{{/if}}
