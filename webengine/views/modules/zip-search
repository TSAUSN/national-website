<div class="mt-16">
  <!-- <h1 class="fs-4 ms-8 mb-6">Searh Results for "Z5005":</h1> -->
  <div class="bg-light p-8 rounded-5 align-items-center gap-4">
    <!-- Shared map of this city's own locations, plotted from the pin data below -->
    <div class="position-relative mb-8" id="city-locations-map-wrapper">
      <div class="rounded-5 city-locations__map goggle-map"></div>
      <div class="map-loader d-none">
        <div class="map-loader__spinner"></div>
      </div>
    </div>
    <div class="row g-3">
      {{each locations as location sort by name ASC where find_in_set('{page.zuid}', city )}}
      {{$cityName = ""}}
      {{if {location.city} !== null && {location.city} !== ""}}
        {{$cityName = {cities.filter({location.city}).title} }}
      {{/if}}
      {{$stateName = ""}}
      {{if {location.state} !== null && {location.state} !== ""}}
        {{$stateName = {states.filter({location.state}).name} }}
      {{/if}}
      <div class="col-12 col-md-4 col-lg-4">
        <div class="accordion" id="locationAccordion-{{location.zuid}}">
          <div class="accordion-item border-0 bg-area rounded-5">
            <h2 class="accordion-header" id="locationHeading-{{location.zuid}}">
              <button
                class="accordion-button collapsed bg-transparent shadow-none p-6 rounded-5"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#locationCollapse-{{location.zuid}}"
                aria-expanded="false"
                aria-controls="locationCollapse-{{location.zuid}}"
                data-location-type="body:city-locations"
                data-function-type="other"
                data-format-type="accordion-block"
                data-page-componentType-type="location card component"
                data-page-componentIndex-type="null"
                onclick="LinkTrackingClickEvent(this,'view_content_click')"
              >
                <span class="text-secondary city-card-name fw-bold"
                  >{{if {location.site_name} !== null && {location.site_name} !== ""}}{{ location.site_name }}{{else}}{{ location.name }}{{/if}}</span
                >
              </button>
            </h2>
            <div
              id="locationCollapse-{{location.zuid}}"
              class="accordion-collapse collapse"
              aria-labelledby="locationHeading-{{location.zuid}}"
              data-bs-parent="#locationAccordion-{{location.zuid}}"
            >
              <div class="accordion-body pt-0 px-6 pb-6">
                <div
                  class="d-flex align-items-start justify-content-between border-top border-2 border-dark-50 py-3"
                >
                  <span class="display-4 display-md-2 fw-bold me-2">General Hours</span>
                  {{if {location.hours_of_operation} == "Contact Store for hours" || {location.hours_of_operation} == "Contact store for hours" || {location.hours_of_operation} == "Contact for hours"}}
                  <span class="text-dark-50 display-4 display-md-2 text-end">Contact location for hours</span>
                  {{else if {location.hours_of_operation} !== null && {location.hours_of_operation} !== ""}}
                  <span class="text-dark-50 display-4 display-md-2 text-end">{{location.hours_of_operation}}</span>
                  {{else}}
                  <span class="text-dark-50 display-4 display-md-2 text-end">Hours not available</span>
                  {{/if}}
                </div>

                <div class="d-flex align-items-center justify-content-between py-3">
                  <span class="display-4 display-md-2 fw-bold me-2">Phone</span>
                  {{if {location.contact_number} !== null && {location.contact_number} !== ""}}
                  <a
                    href="tel:{{location.contact_number}}"
                    class="text-secondary-200 display-4 display-md-2 text-decoration-none text-end"
                    data-link-location-type="body:city-locations"
                    data-link-function-type="other"
                    data-link-format-type="button"
                    data-link-type="internal"
                    data-location-id="{{location.zuid}}"
                    data-location-name="{{location.name}}"
                    onclick="LocationTrackingSearchEvent(this,'location_search_results_click')"
                    >{{location.contact_number}}</a
                  >
                  {{else}}
                  <span class="text-dark-50 display-4 display-md-2">Phone not available</span>
                  {{/if}}
                </div>

                <div class="d-flex align-items-start justify-content-between py-3">
                  <span class="display-4 display-md-2 fw-bold me-2">Address</span>
                  {{if {location.address} !== null && {location.address} !== ""}}
                  <span class="text-dark-50 display-4 display-md-2 text-end"
                    >{{location.address}}{{if {$cityName} !== null && {$cityName} !== ""}}, {{$cityName}}{{/if}}{{if {$stateName} !== null && {$stateName} !== ""}}, {{$stateName}}{{/if}}{{if {location.zipcode} !== null && {location.zipcode} !== ""}} {{location.zipcode}}{{/if}}</span
                  >
                  {{else}}
                  <span class="text-dark-50 display-4 display-md-2 text-end">Address not available</span>
                  {{/if}}
                </div>

                {{if {location.address} !== null && {location.address} !== ""}}
                <div class="d-flex align-items-start justify-content-between py-3">
                  <span class="display-4 display-md-2 fw-bold me-2">Directions</span>
                  <div class="text-dark-50 display-4 display-md-2 text-end">
                    <a
                      href="https://www.google.com/maps/dir/?api=1&origin=current-location&destination={{location.address}}{{if {$cityName} !== null && {$cityName} !== ""}}, {{$cityName}}{{/if}}{{if {$stateName} !== null && {$stateName} !== ""}}, {{$stateName}}{{/if}}{{if {location.zipcode} !== null && {location.zipcode} !== ""}} {{location.zipcode}}{{/if}}&travelmode=walking"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-dark-50 me-2 text-decoration-underline"
                      data-link-location-type="body:city-locations"
                      data-link-function-type="other"
                      data-link-format-type="button"
                      data-link-type="external"
                      data-location-id="{{location.zuid}}"
                      data-location-name="{{location.name}}"
                      onclick="LocationTrackingSearchEvent(this,'location_search_results_click')"
                      >Walking</a
                    >
                    <a
                      href="https://www.google.com/maps/dir/?api=1&origin=current-location&destination={{location.address}}{{if {$cityName} !== null && {$cityName} !== ""}}, {{$cityName}}{{/if}}{{if {$stateName} !== null && {$stateName} !== ""}}, {{$stateName}}{{/if}}{{if {location.zipcode} !== null && {location.zipcode} !== ""}} {{location.zipcode}}{{/if}}&travelmode=driving"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-dark-50 me-2 text-decoration-underline"
                      data-link-location-type="body:city-locations"
                      data-link-function-type="other"
                      data-link-format-type="button"
                      data-link-type="external"
                      data-location-id="{{location.zuid}}"
                      data-location-name="{{location.name}}"
                      onclick="LocationTrackingSearchEvent(this,'location_search_results_click')"
                      >Driving</a
                    >
                    <a
                      href="https://www.google.com/maps/dir/?api=1&origin=current-location&destination={{location.address}}{{if {$cityName} !== null && {$cityName} !== ""}}, {{$cityName}}{{/if}}{{if {$stateName} !== null && {$stateName} !== ""}}, {{$stateName}}{{/if}}{{if {location.zipcode} !== null && {location.zipcode} !== ""}} {{location.zipcode}}{{/if}}&travelmode=transit"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-dark-50 text-decoration-underline"
                      data-link-location-type="body:city-locations"
                      data-link-function-type="other"
                      data-link-format-type="button"
                      data-link-type="external"
                      data-location-id="{{location.zuid}}"
                      data-location-name="{{location.name}}"
                      onclick="LocationTrackingSearchEvent(this,'location_search_results_click')"
                      >Public Transport</a
                    >
                  </div>
                </div>
                {{/if}}

                {{if {location.redirect_url} !== null && {location.redirect_url} !== ""}}
                <div class="d-flex gap-2 mt-4">
                  <a
                    href="{{location.redirect_url}}"
                    class="btn btn-info d-flex align-items-center justify-content-center w-100 display-4"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-link-function="navigation"
                    data-link-format="button"
                    data-link-location="body:city-locations"
                    data-link-type="external"
                    data-link-url="{{location.redirect_url}}"
                    data-location-id="{{location.zuid}}"
                    data-location-name="{{location.name}}"
                    data-link-text="View Location Website"
                    onclick="LocationTrackingResultsClickEvent(this)"
                  >
                    <span class="material-symbols-outlined text-light me-2">arrow_outward</span>
                    View Location Website
                  </a>
                </div>
                {{else}}
                <div class="d-flex gap-2 mt-4">
                  <a
                    href="{{truepath({location.zuid})}}"
                    class="btn btn-info d-flex align-items-center justify-content-center w-100 display-4"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-link-function="navigation"
                    data-link-format="button"
                    data-link-location="body:city-locations"
                    data-link-type="internal"
                    data-link-url="{{truepath({location.zuid})}}"
                    data-location-id="{{location.zuid}}"
                    data-location-name="{{location.name}}"
                    data-link-text="View Location Website"
                    onclick="LocationTrackingResultsClickEvent(this)"
                  >
                    <span class="material-symbols-outlined text-light me-2">arrow_outward</span>
                    View Location Website
                  </a>
                </div>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</div>

<!-- Pin data for this city's locations, plotted by the inline script below. Names are entity-encoded here and decoded to plain text by the script. -->
<script type="application/json" id="city-locations-map-data">
[{{each locations as location sort by name ASC where find_in_set('{page.zuid}', city )}}{
  "zuid": "{{location.zuid.escapeForJs()}}",
  "name": "{{if {location.site_name} !== null && {location.site_name} !== ""}}{{location.site_name.htmlentities().escapeForJs()}}{{else}}{{location.name.htmlentities().escapeForJs()}}{{/if}}",
  "lat": "{{location.latitude.escapeForJs()}}",
  "lng": "{{location.longitude.escapeForJs()}}"
}{{location._arraycomma}}{{/each}}]
</script>

<script>
  const cityCardNames = document.querySelectorAll('.city-card-name');
  const regex = /\b(?!\b(?:a|an|the|and|but|or|nor|for|so|yet|as|at|by|in|of|off|on|per|to|up|from|into|onto|over|with)\b)([A-Za-z0-9À-ſ]+(?:['-][A-Za-z0-9À-ſ]+)*)\b/gi;

  cityCardNames.forEach((cityCardName) => {
    const result = cityCardName.textContent.replace(regex, (word) => {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    });

    cityCardName.textContent = result;
  });

  // Clicking a map pin (see the pin script below) expands or collapses the
  // matching location's accordion card to match the pin's new
  // selected/deselected state, scrolling to it when it opens.
  document.addEventListener('cityLocationMarkerClicked', (event) => {
    const detail = event.detail || {};
    const zuid = detail.zuid;
    if (!zuid) return;

    const collapseEl = document.getElementById(`locationCollapse-${zuid}`);
    if (!collapseEl) return;

    const buttonEl = document.querySelector(`[data-bs-target="#locationCollapse-${zuid}"]`);

    if (detail.selected) {
      collapseEl.classList.add('show');
      if (buttonEl) {
        buttonEl.classList.remove('collapsed');
        buttonEl.setAttribute('aria-expanded', 'true');
      }
      collapseEl.closest('.accordion').scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      collapseEl.classList.remove('show');
      if (buttonEl) {
        buttonEl.classList.add('collapsed');
        buttonEl.setAttribute('aria-expanded', 'false');
      }
    }
  });

  // Plots this city's locations from #city-locations-map-data on window.map.
  // site.js creates the map (initAutocomplete) when it scrolls into view, then
  // dispatches mapReady on window; pins are plotted once, after that.
  (() => {
    const dataScript = document.getElementById('city-locations-map-data');
    const mapWrapper = document.getElementById('city-locations-map-wrapper');
    if (!dataScript || !mapWrapper) return;

    // Decodes HTML entities to plain text; DOMParser doesn't run scripts.
    const decodeEntities = (str) =>
      str ? new DOMParser().parseFromString(str, 'text/html').documentElement.textContent : '';

    let pins = [];
    try {
      pins = JSON.parse(dataScript.textContent)
        .map((location) => ({
          zuid: location.zuid,
          name: decodeEntities(location.name),
          lat: parseFloat(location.lat),
          lng: parseFloat(location.lng)
        }))
        // Skip locations without usable coordinates instead of plotting at 0,0.
        .filter((pin) => Number.isFinite(pin.lat) && Number.isFinite(pin.lng));
    } catch (error) {
      console.error('Error parsing city locations map data:', error);
    }

    // No usable pins: hide the map rather than show an empty continental-US view.
    // A hidden map never enters the viewport, so Google Maps isn't loaded for it.
    if (!pins.length) {
      mapWrapper.classList.add('d-none');
      return;
    }

    let plotted = false;
    let selectedMarker = null;

    const plotPins = () => {
      const map = window.map;
      if (plotted || !window.google?.maps?.Map || !(map instanceof google.maps.Map)) return;
      plotted = true;

      // labelOrigin is the label's centre, relative to the icon's top-left:
      // horizontally centred, just below the 40x40 pin. Both icons share it so
      // the label stays put when the icon swaps on selection.
      const pinIcon = (url) => ({
        url,
        origin: new google.maps.Point(0, 0),
        anchor: new google.maps.Point(15, 40),
        scaledSize: new google.maps.Size(40, 40),
        labelOrigin: new google.maps.Point(20, 53)
      });
      const defaultIcon = pinIcon('https://8hxvw8tw.media.zestyio.com/location_filled50.png');
      const selectedIcon = pinIcon('https://8hxvw8tw.media.zestyio.com/location_filled.png');
      const bounds = new google.maps.LatLngBounds();

      pins.forEach((pin) => {
        const position = { lat: pin.lat, lng: pin.lng };
        const pinName = pin.name || 'Salvation Army Location';
        const marker = new google.maps.Marker({
          position,
          map,
          icon: defaultIcon,
          title: pinName,
          // Always-visible name under the pin (rendered as plain text).
          label: {
            text: pinName,
            fontSize: '12px',
            fontWeight: '600',
            className: 'bg-white text-body border rounded-2 px-2 py-1 lh-1 shadow-sm text-nowrap'
          }
        });

        // Clicking a pin selects it (deselecting any other); clicking the
        // selected pin again deselects it.
        marker.addListener('click', () => {
          const isSelected = selectedMarker !== marker;
          if (selectedMarker) selectedMarker.setIcon(defaultIcon);
          marker.setIcon(isSelected ? selectedIcon : defaultIcon);
          selectedMarker = isSelected ? marker : null;
          if (isSelected) map.setCenter(position);

          document.dispatchEvent(
            new CustomEvent('cityLocationMarkerClicked', {
              detail: { zuid: pin.zuid, selected: isSelected }
            })
          );
        });

        bounds.extend(position);
      });

      if (pins.length === 1) {
        map.setCenter(bounds.getCenter());
        map.setZoom(12);
      } else {
        map.fitBounds(bounds);
      }
    };

    // Plot now if the map already exists, otherwise wait for site.js.
    plotPins();
    if (!plotted) window.addEventListener('mapReady', plotPins, { once: true });
  })();
</script>
