<style>
  @media (min-width: 1024px) {
    .city-location-toggle {
      min-height: calc(3 * 1.2em + 2 * 1.5rem);
    }
  }
  .city-location-toggle .city-card-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    line-height: 1.2;
  }
  .city-location-toggle:not(.collapsed) .city-card-name {
    -webkit-line-clamp: unset;
    line-clamp: none;
  }
</style>

<div class="mt-16">
