<script type="application/json" id="city-locations-map-data">
[{{each locations as location sort by name ASC where find_in_set('{page.zuid}', city )}}{
  "zuid": "{{location.zuid.escapeForJs()}}",
  "name": "{{if {location.site_name} !== null && {location.site_name} !== ""}}{{location.site_name.htmlentities().escapeForJs()}}{{else}}{{location.name.htmlentities().escapeForJs()}}{{/if}}",
  "lat": "{{location.latitude.escapeForJs()}}",
  "lng": "{{location.longitude.escapeForJs()}}"
}{{location._arraycomma}}{{/each}}]
</script>

<script>
  document.addEventListener('cityLocationMarkerClicked', (event) => {
    const detail = event.detail || {};
    const zuid = detail.zuid;
    if (!zuid) return;

    const collapseEl = document.getElementById(`locationCollapse-${zuid}`);
    if (!collapseEl) return;

    const buttonEl = document.querySelector(`[data-bs-target="#locationCollapse-${zuid}"]`);

    if (detail.selected) {
      collapseEl.classList.add('show');
      if (buttonEl) {
        buttonEl.classList.remove('collapsed');
        buttonEl.setAttribute('aria-expanded', 'true');
      }
      collapseEl.closest('.accordion').scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      collapseEl.classList.remove('show');
      if (buttonEl) {
        buttonEl.classList.add('collapsed');
        buttonEl.setAttribute('aria-expanded', 'false');
      }
    }
  });

  (() => {
    const titleCaseRegex = /\b(?!\b(?:a|an|the|and|but|or|nor|for|so|yet|as|at|by|in|of|off|on|per|to|up|from|into|onto|over|with)\b)([A-Za-z0-9À-ſ]+(?:['’-][A-Za-z0-9À-ſ]+)*)\b/gi;
    const KEPT_ACRONYMS = new Set(['DC', 'PR', 'TSA', 'USA']);
    // Kept only in state positions, since some are also words (LA Crosse, CO., ME).
    const STATE_CODES = new Set([
      'AL', 'AK', 'AZ', 'AR', 'CA', 'CO', 'CT', 'DE', 'FL', 'GA',
      'HI', 'ID', 'IL', 'IN', 'IA', 'KS', 'KY', 'LA', 'ME', 'MD',
      'MA', 'MI', 'MN', 'MS', 'MO', 'MT', 'NE', 'NV', 'NH', 'NJ',
      'NM', 'NY', 'NC', 'ND', 'OH', 'OK', 'OR', 'PA', 'RI', 'SC',
      'SD', 'TN', 'TX', 'UT', 'VT', 'VA', 'WA', 'WV', 'WI', 'WY'
    ]);
    const isStatePosition = (text, offset, length) => {
      const before = text.slice(0, offset);
      const after = text.slice(offset + length);
      return (
        before.endsWith(', ') ||
        before.endsWith('(') ||
        after.startsWith(')') ||
        after.startsWith(' (')
      );
    };
    const titleCaseWords = (text) =>
      text.replace(titleCaseRegex, (word, _match, offset, fullText) => {
        if (KEPT_ACRONYMS.has(word)) return word;
        if (STATE_CODES.has(word) && isStatePosition(fullText, offset, word.length)) return word;
        if (/[a-z]/.test(word) && /[A-Z]/.test(word.slice(1))) return word;
        return word
          .split('-')
          .map((part) => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())
          .join('-');
      });

    // Mixed-case names are left as entered.
    const toTitleCase = (name) =>
      /\p{Lu}/u.test(name) && /\p{Ll}/u.test(name) ? name : titleCaseWords(name);

    document.querySelectorAll('.featured-article .city-card-name').forEach((el) => {
      el.textContent = titleCaseWords(el.textContent);
    });
    document.querySelectorAll('.accordion .city-card-name').forEach((el) => {
      el.textContent = toTitleCase(el.textContent);
      el.title = el.textContent;
    });

    const dataScript = document.getElementById('city-locations-map-data');
    const mapWrapper = document.getElementById('city-locations-map-wrapper');
    if (!dataScript || !mapWrapper) return;

    // Names arrive entity-encoded; DOMParser decodes them without running scripts.
    const decodeEntities = (str) =>
      str ? new DOMParser().parseFromString(str, 'text/html').documentElement.textContent : '';

    let pins = [];
    try {
      pins = JSON.parse(dataScript.textContent)
        .map((location) => ({
          zuid: location.zuid,
          name: decodeEntities(location.name),
          lat: parseFloat(location.lat),
          lng: parseFloat(location.lng)
        }))
        .filter((pin) => Number.isFinite(pin.lat) && Number.isFinite(pin.lng));
    } catch (error) {
      console.error('Error parsing city locations map data:', error);
    }

    if (!pins.length) {
      mapWrapper.classList.add('d-none');
      return;
    }

    const ICON_SIZE = 40;
    const ICON_ANCHOR = { x: 15, y: 40 };
    // Opaque bounds of both pin PNGs (alpha > 32) within the icon.
    const PIN_SHAPE = { left: 6, top: 3, right: 34, bottom: 37 };
    const LABEL_ORIGIN = { x: 20, y: 53 };
    // Label metrics must match the label's font and className below.
    const LABEL_FONT_FAMILY = 'Roboto, Arial, sans-serif';
    const LABEL_FONT = `600 12px ${LABEL_FONT_FAMILY}`;
    const LABEL_EXTRA_WIDTH = 2 * 8 + 2 * 1 + 2;
    const LABEL_HEIGHT = 12 + 2 * 4 + 2 * 1;
    const LABEL_GAP = 4;
    const PIN_GAP = 2;
    // Keeps labels clear of the Google attribution.
    const LABEL_BOTTOM_RESERVE = 24;
    const LABEL_MAX_CHARS = 30;
    const NARROW_MAP_WIDTH = 400;

    const truncate = (text) =>
      text.length > LABEL_MAX_CHARS ? `${text.slice(0, LABEL_MAX_CHARS - 1).trimEnd()}…` : text;

    let plotted = false;

    const plotPins = () => {
      const map = window.map;
      if (plotted || !window.google?.maps?.Map || !(map instanceof google.maps.Map)) return;
      plotted = true;

      const pinIcon = (url) => ({
        url,
        origin: new google.maps.Point(0, 0),
        anchor: new google.maps.Point(ICON_ANCHOR.x, ICON_ANCHOR.y),
        scaledSize: new google.maps.Size(ICON_SIZE, ICON_SIZE),
        labelOrigin: new google.maps.Point(LABEL_ORIGIN.x, LABEL_ORIGIN.y)
      });
      const defaultIcon = pinIcon('https://8hxvw8tw.media.zestyio.com/location_filled50.png');
      const selectedIcon = pinIcon('https://8hxvw8tw.media.zestyio.com/location_filled.png');
      const bounds = new google.maps.LatLngBounds();

      const Z_SELECTED = google.maps.Marker.MAX_ZINDEX + 1;
      const Z_HOVERED = google.maps.Marker.MAX_ZINDEX + 2;
      let entries = [];
      let selectedEntry = null;
      let hoveredEntry = null;

      // Empty overlay, used only for its projection.
      const overlay = new google.maps.OverlayView();
      overlay.onAdd = () => {};
      overlay.onRemove = () => {};

      const measureContext = document.createElement('canvas').getContext('2d');
      const labelWidth = (entry) => {
        if (entry.width === undefined) {
          measureContext.font = LABEL_FONT;
          entry.width =
            Math.ceil(measureContext.measureText(entry.label.text).width) + LABEL_EXTRA_WIDTH;
        }
        return entry.width;
      };

      // Redundant setLabel calls make labels flicker.
      const setLabelShown = (entry, show) => {
        if (entry.shown === show) return;
        entry.shown = show;
        entry.marker.setLabel(show ? entry.label : null);
      };

      const restoreZIndex = (entry) => {
        entry.marker.setZIndex(entry === selectedEntry ? Z_SELECTED : undefined);
      };

      const boxesOverlap = (a, b, gap) =>
        a.left < b.right + gap &&
        b.left < a.right + gap &&
        a.top < b.bottom + gap &&
        b.top < a.bottom + gap;

      // Label collision pass: other pins' visible shapes count as blockers too.
      const updateLabels = () => {
        const projection = overlay.getProjection();
        if (!projection) return;

        const mapDiv = map.getDiv();
        const mapWidth = mapDiv.clientWidth;
        const mapHeight = mapDiv.clientHeight;
        const narrowMap = mapWidth < NARROW_MAP_WIDTH;
        const shownBoxes = [];

        const points = new Map(
          entries.map((entry) => [
            entry,
            projection.fromLatLngToContainerPixel(entry.marker.getPosition())
          ])
        );
        const pinBoxes = [];
        points.forEach((point, entry) => {
          if (!point) return;
          const iconLeft = point.x - ICON_ANCHOR.x;
          const iconTop = point.y - ICON_ANCHOR.y;
          pinBoxes.push({
            entry,
            left: iconLeft + PIN_SHAPE.left,
            right: iconLeft + PIN_SHAPE.right,
            top: iconTop + PIN_SHAPE.top,
            bottom: iconTop + PIN_SHAPE.bottom
          });
        });

        const ordered = selectedEntry
          ? [selectedEntry, ...entries.filter((entry) => entry !== selectedEntry)]
          : entries;

        ordered.forEach((entry) => {
          const isHovered = entry === hoveredEntry;
          const point = points.get(entry);
          if (!point) {
            if (!isHovered) setLabelShown(entry, entry === selectedEntry);
            return;
          }

          const width = labelWidth(entry);
          const centerX = point.x - ICON_ANCHOR.x + LABEL_ORIGIN.x;
          const centerY = point.y - ICON_ANCHOR.y + LABEL_ORIGIN.y;
          const box = {
            left: centerX - width / 2,
            right: centerX + width / 2,
            top: centerY - LABEL_HEIGHT / 2,
            bottom: centerY + LABEL_HEIGHT / 2
          };
          const fitsMap =
            box.left >= 0 &&
            box.top >= 0 &&
            box.right <= mapWidth &&
            box.bottom <= mapHeight - LABEL_BOTTOM_RESERVE;
          const blockedByPin = pinBoxes.some(
            (pinBox) => pinBox.entry !== entry && boxesOverlap(box, pinBox, PIN_GAP)
          );
          const show = isHovered
            ? entry.shown
            : entry === selectedEntry ||
              (!narrowMap &&
                fitsMap &&
                !blockedByPin &&
                !shownBoxes.some((shownBox) => boxesOverlap(box, shownBox, LABEL_GAP)));

          if (show) shownBoxes.push(box);
          if (!isHovered) setLabelShown(entry, show);
        });
      };

      // The first draw means the projection is ready; idle covers zoom/pan after.
      let projectionReady = false;
      overlay.draw = () => {
        if (projectionReady) return;
        projectionReady = true;
        updateLabels();
      };

      // A tap can fire mouseover without mouseout, so hover is limited to real hover devices.
      const canHover = window.matchMedia?.('(hover: hover)').matches;

      entries = pins.map((pin) => {
        const position = { lat: pin.lat, lng: pin.lng };
        const pinName = toTitleCase(pin.name || 'Salvation Army Location');
        const marker = new google.maps.Marker({
          position,
          map,
          icon: defaultIcon,
          title: pinName
        });
        const entry = {
          zuid: pin.zuid,
          marker,
          shown: false,
          label: {
            text: truncate(pinName),
            fontFamily: LABEL_FONT_FAMILY,
            fontSize: '12px',
            fontWeight: '600',
            // Maps sets the label colour inline, so a class can't override it.
            color: '#1c1b1f',
            className: 'bg-white border rounded-2 px-2 py-1 lh-1 shadow-sm text-nowrap'
          }
        };

        marker.addListener('click', () => {
          const previousEntry = selectedEntry;
          const isSelected = previousEntry !== entry;
          if (previousEntry) previousEntry.marker.setIcon(defaultIcon);
          marker.setIcon(isSelected ? selectedIcon : defaultIcon);
          selectedEntry = isSelected ? entry : null;
          if (previousEntry && previousEntry !== hoveredEntry) restoreZIndex(previousEntry);
          if (entry !== hoveredEntry) restoreZIndex(entry);

          // setCenter's idle re-runs updateLabels, except when already centred.
          const center = map.getCenter();
          const alreadyCentered =
            center && center.equals(new google.maps.LatLng(position.lat, position.lng));
          if (isSelected) map.setCenter(position);
          if (!isSelected || alreadyCentered) updateLabels();

          const notifyCard = (zuid, selected) =>
            document.dispatchEvent(
              new CustomEvent('cityLocationMarkerClicked', { detail: { zuid, selected } })
            );
          if (isSelected && previousEntry) notifyCard(previousEntry.zuid, false);
          notifyCard(pin.zuid, isSelected);
        });

        if (canHover) {
          marker.addListener('mouseover', () => {
            const previousHovered = hoveredEntry;
            hoveredEntry = entry;
            if (previousHovered && previousHovered !== entry) restoreZIndex(previousHovered);
            marker.setZIndex(Z_HOVERED);
            setLabelShown(entry, true);
            if (previousHovered && previousHovered !== entry) updateLabels();
          });
          marker.addListener('mouseout', () => {
            if (hoveredEntry === entry) hoveredEntry = null;
            restoreZIndex(entry);
            updateLabels();
          });
        }

        bounds.extend(position);
        return entry;
      });

      overlay.setMap(map);
      map.addListener('idle', updateLabels);

      if (document.fonts?.load) {
        document.fonts
          .load(LABEL_FONT)
          .then(() => {
            entries.forEach((entry) => {
              entry.width = undefined;
            });
            updateLabels();
          })
          .catch(() => {});
      }

      if (pins.length === 1) {
        map.setCenter(bounds.getCenter());
        map.setZoom(12);
      } else {
        const edgePadding = map.getDiv().clientWidth < NARROW_MAP_WIDTH ? 24 : 40;
        const labelBelowPin = LABEL_ORIGIN.y - ICON_ANCHOR.y + LABEL_HEIGHT / 2;
        map.fitBounds(bounds, {
          top: 48,
          right: edgePadding,
          bottom: labelBelowPin + LABEL_BOTTOM_RESERVE + 4,
          left: edgePadding
        });
      }
    };

    plotPins();
    if (!plotted) window.addEventListener('mapReady', plotPins, { once: true });
  })();
</script>
