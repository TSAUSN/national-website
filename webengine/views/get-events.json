(** NOW() is GMT; the 1-day margin keeps events that end later today in US time zones. **)
{{$where = where find_in_set('0', property) sort by event_end_date_with_time asc, event_date_with_time asc }}
{{if {$field} == "any"}}
{{$where = where (find_in_set('{$z1}', property) OR find_in_set('{$z1}', divisions) OR find_in_set('{$z1}', territories)) AND (event_end_date_with_time >= DATE_ADD(NOW(), INTERVAL -1 DAY) OR event_date_with_time >= DATE_ADD(NOW(), INTERVAL -1 DAY)) sort by event_end_date_with_time asc, event_date_with_time asc }}
{{else}}
{{$where = where (find_in_set('{$z1}', {$field}) OR find_in_set('{$z2}', {$field}) OR find_in_set('{$z3}', {$field}) OR find_in_set('{$z4}', {$field}) OR find_in_set('{$z5}', {$field})) AND (event_end_date_with_time >= DATE_ADD(NOW(), INTERVAL -1 DAY) OR event_date_with_time >= DATE_ADD(NOW(), INTERVAL -1 DAY)) sort by event_end_date_with_time asc, event_date_with_time asc }}
{{/if}}
{
  "cutoff": "NOW() - 1 DAY, requested {{instance.date(Y-m-d H:i:s)}} GMT",
  "events": [{{if {$hasOrg} }}{{each events as event {$where} limit 0, 100}}
    {
      "zuid": "{{event.zuid}}",
      "title": "{{event.title.escapeForJs()}}",
      "url": "{{event.getUrl()}}",
      "image": "{{event.image.getImage()}}",
      "image_raw": "{{event.image.escapeForJs()}}",
      "address": "{{event.address.escapeForJs()}}",
      "start": "{{if {event.event_date_with_time} }}{{event.event_date_with_time.date(Y-m-d H:i:s)}}{{/if}}",
      "end": "{{if {event.event_end_date_with_time} }}{{event.event_end_date_with_time.date(Y-m-d H:i:s)}}{{/if}}",
      "summary": "{{event.date_time_summary.escapeForJs()}}",
      "city": "{{event.city}}",
      "state": "{{event.state}}"
    }{{event._arraycomma}}{{/each}}{{/if}}
  ]
}
