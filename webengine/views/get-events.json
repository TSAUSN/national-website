{{$raw = {request.queryParam(z1)} }}
{{$raw = {$raw.escapeForJs()} }}
{{$found = }}
{{if {$field} == "property" || {$field} == "any"}}{{$found = {locations.filter(z.zuid = '{$raw}').zuid} }}{{/if}}
{{if {$found} }}{{else}}{{if {$field} == "divisions" || {$field} == "any"}}{{$found = {divisions.filter(z.zuid = '{$raw}').zuid} }}{{/if}}{{/if}}
{{if {$found} }}{{else}}{{if {$field} == "territories" || {$field} == "any"}}{{$found = {territories.filter(z.zuid = '{$raw}').zuid} }}{{/if}}{{/if}}
{{if {$found} }}{{if {$found} == {$raw} }}{{$z1 = {$found} }}{{$hasOrg = 1}}{{/if}}{{/if}}
{{/if}}

